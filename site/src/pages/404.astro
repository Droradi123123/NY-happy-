---
/** Served with status 404 (Cloudflare not_found_handling). A night that is over lands here, so it offers the next ones. */
import Base from '../layouts/Base.astro';
import PartyCard from '../components/PartyCard.astro';
import { partyData, venueOf } from '../lib/data';
import { markSvg } from '../lib/brand.mjs';
const { parties, venues } = await partyData();
const next = parties.slice(0, 6);
---
<Base title="Page Not Found" description="This page does not exist or the party is over. Here are the next parties in NYC and the happy hours on right now." noindex>
  <div class="nf-mark" aria-hidden="true" set:html={markSvg()} />
  <h1>That page isn't here</h1>
  <p class="lede">If it was a party, it may be over: past nights leave the site.</p>
  <p><a class="btn" href="/parties">Parties coming up</a> <a class="btn ghost" href="/happy-hours/now">Happy hour right now</a></p>
  {next.length > 0 && (
    <section class="section">
      <h2>Next parties in NYC</h2>
      <div class="xgrid">{next.map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}</div>
    </section>
  )}
</Base>
<style>
  .nf-mark { width: 88px; height: 88px; margin: 8px 0 -4px; transform: rotate(-10deg); }
  .nf-mark :global(svg) { width: 100%; height: 100%; display: block; }
</style>
