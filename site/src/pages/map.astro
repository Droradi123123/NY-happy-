---
import Base from '../layouts/Base.astro';
import Explorer from '../components/Explorer.astro';
import { allBars, allHoods, partyData } from '../lib/data';
const bars = await allBars();
const hoods = (await allHoods()).filter((h) => bars.some((b) => b.hoodSlug === h.slug)).sort((a, b) => a.name.localeCompare(b.name));
const { parties } = await partyData();
const genres = [...new Set(parties.flatMap((p) => p.genres))].sort();
---
<Base title="NYC Happy Hour and Party Map" description="Every NYC happy hour and party on one map. Filter by what's on now, day, subway line, price and music; tap a pin for the deal or the ticket.">
  <h1>The YaY NYC Map</h1>
  <div class="tabs" role="tablist" aria-label="What to show">
    <button role="tab" type="button" aria-selected="true" aria-controls="map-bars" id="tab-bars">Happy hours</button>
    <button role="tab" type="button" aria-selected="false" aria-controls="map-parties" id="tab-parties">Parties</button>
  </div>
  <div id="map-bars" role="tabpanel" aria-labelledby="tab-bars"><Explorer kind="bars" hoods={hoods} mode="map" heading="Happy hour map" /></div>
  <div id="map-parties" role="tabpanel" aria-labelledby="tab-parties" hidden><Explorer kind="parties" genres={genres} mode="map" heading="Party map" /></div>
</Base>
<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[role=tab]');
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => { x.setAttribute('aria-selected', String(x === t)); document.getElementById(x.getAttribute('aria-controls')!)!.hidden = x !== t; });
    window.dispatchEvent(new Event('resize'));
    document.getElementById(t.getAttribute('aria-controls')!)!.querySelector<HTMLButtonElement>('[data-view="map"]')?.click();
  }));
</script>
<style>
  .tabs { display: inline-flex; border: 2px solid var(--ink); border-radius: 14px; overflow: hidden; }
  .tabs button { border: 0; background: #fff; font: inherit; font-weight: 800; padding: 0 18px; min-height: 48px; cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--yellow); }
</style>
