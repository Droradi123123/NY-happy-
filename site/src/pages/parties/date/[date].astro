---
/**
 * One page per night: /parties/date/2026-10-31 ("nyc parties october 31"). The next 14 nights, and the
 * 7 before today (kept up, out of the sitemap, then a 301 to the night of the week). Indexed from
 * INDEX_MIN parties. Every number comes from the listed nights.
 */
import Base from '../../../layouts/Base.astro';
import PartyCard from '../../../components/PartyCard.astro';
import Fresh from '../../../components/Fresh.astro';
import HappyHourBefore from '../../../components/HappyHourBefore.astro';
import { partyData, venueOf, nightDate, nyTime, cleanTitle, priceLabel, GENRE_NAME, type Venue, type Day, type Party } from '../../../lib/data';
import { datePages, partyLists, type DatePage } from '../../../lib/partyLists';
import { crumbs, faqLd, collectionLd, freshDescription } from '../../../lib/seo';
import { plural } from '../../../lib/stats';
import proof from '../../../data/proof.json';

export async function getStaticPaths() {
  const pages = await datePages();
  return pages.map((page, i) => ({ params: { date: page.date }, props: { page, prev: pages[i - 1] ?? null, next: pages[i + 1] ?? null } }));
}
const { page, prev, next } = Astro.props as { page: DatePage; prev: DatePage | null; next: DatePage | null };
const { parties, venues } = await partyData();
const ps = page.parties, n = ps.length;
const long = nightDate(page.date, { weekday: 'long', month: 'long', day: 'numeric' });
const monthDay = nightDate(page.date, { month: 'long', day: 'numeric' });
const year = page.date.slice(0, 4);
const D = page.weekday[0].toUpperCase() + page.weekday.slice(1);
const lists = await partyLists();
const dayList = lists.find((l) => l.kind === 'day' && l.slug === page.weekday) ?? null;
// tonight, tomorrow and this weekend exist only while something is listed for them
const whenLinks = ([['tonight', 'Parties tonight'], ['tomorrow', 'Tomorrow night'], ['this-weekend', 'This weekend']] as const)
  .filter(([slug]) => lists.some((l) => l.slug === slug)).map(([slug, text]) => [`/parties/${slug}`, text] as const);
const priced = ps.filter((p) => p.price_from !== null && p.price_from > 0 && p.price_status !== 'free').map((p) => p.price_from!);
const free = ps.filter((p) => p.price_status === 'free').length;
const venueIds = [...new Set(ps.map((p) => p.venue_id))];
const genreCount = [...ps.flatMap((p) => p.genres).reduce((m, g) => m.set(g, (m.get(g) ?? 0) + 1), new Map<string, number>())].sort((a, b) => b[1] - a[1]);
const topGenres = genreCount.slice(0, 3).map(([g, c]) => `${GENRE_NAME[g] ?? g} (${c})`);
// a night that is over: the same night of the week, coming up
const standIns = n ? [] : (dayList?.parties ?? parties).slice(0, 6);
const kw = `nyc parties ${monthDay.toLowerCase()}`;
const inShort = page.past
  ? `${long}, ${year} is over. The next ${D} nights are below.`
  : n ? `${plural(n, 'party', 'parties')} in NYC on ${long} at ${plural(venueIds.length, 'venue')}${topGenres.length ? `; most of it ${topGenres.slice(0, 2).join(' and ')}` : ''}${priced.length ? `; tickets from $${Math.round(Math.min(...priced))}` : ''}${free ? `, ${free} free` : ''}.`
  : `No parties are listed for ${long} yet. They appear here as tickets go on sale.`;
const description = freshDescription(`NYC parties on ${long}`, page.past ? [`This night is over; the next ${D} night parties, with doors, age and tickets.`] : [
  n ? `${plural(n, 'party', 'parties')} with doors time, venue, age, price and tickets.` : 'Nothing listed yet; the next parties, with doors, age and tickets.',
  priced.length ? `Tickets from $${Math.round(Math.min(...priced))}.` : '',
  topGenres.length ? `Mostly ${topGenres.slice(0, 2).join(', ')}.` : '',
]);
// Nov 10: the night at a glance, as the answers people ask for ("what's on in Brooklyn on the 14th", "what's cheap",
// "what starts early"), each computed from the listed nights
const dow = (['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'] as Day[])[new Date(`${page.date}T12:00:00Z`).getUTCDay()];
const onSale = ps.filter((p) => p.event_status !== 'sold_out');
const tally = (f: (p: Party) => string | null | undefined) => [...ps.reduce((m, p) => { const k = f(p); return k ? m.set(k, (m.get(k) ?? 0) + 1) : m; }, new Map<string, number>())].sort((a, b) => b[1] - a[1]);
const byBorough = tally((p) => p.borough), byHood = tally((p) => p.neighborhood);
const nyHour = (iso: string) => Number(new Date(iso).toLocaleString('en-US', { hour: 'numeric', hour12: false, timeZone: 'America/New_York' })) % 24;
const dayParties = ps.filter((p) => { const h = nyHour(p.doors_at ?? p.starts_at); return h >= 11 && h < 18; });
const late = ps.filter((p) => { const h = nyHour(p.doors_at ?? p.starts_at); return h >= 23 || h < 5; });
const cheap = [...onSale].filter((p) => p.price_status !== 'free' && p.price_from !== null && p.price_from > 0).sort((a, b) => a.price_from! - b.price_from!).slice(0, 3);
const freeNights = onSale.filter((p) => p.price_status === 'free');
const young = ps.filter((p) => p.age_min !== null && p.age_min < 21);
const soldOut = ps.length - onSale.length;
const at = (p: Party) => `${cleanTitle(p.title)} at ${venueOf(p, venues)?.name ?? 'a NYC venue'}`;
const glance: [string, string][] = !page.past && n >= 3 ? ([
  ['Where', byBorough.length ? `${byBorough.map(([b, c]) => `${b} ${c}`).join(', ')}${byHood.length > 1 ? `; most in ${byHood.slice(0, 3).map(([h, c]) => `${h} (${c})`).join(', ')}` : ''}` : ''],
  ['Music', genreCount.length ? genreCount.slice(0, 5).map(([g, c]) => `${GENRE_NAME[g] ?? g} ${c}`).join(', ') : ''],
  ['Cheapest tickets', cheap.length ? cheap.map((p) => `${at(p)} (${priceLabel(p).toLowerCase()})`).join('; ') : ''],
  ['Free', freeNights.length ? freeNights.slice(0, 3).map(at).join('; ') + (freeNights.length > 3 ? `, and ${freeNights.length - 3} more` : '') : ''],
  ['Day parties', dayParties.length ? dayParties.slice(0, 3).map((p) => `${at(p)} (${nyTime(p.doors_at ?? p.starts_at)})`).join('; ') : ''],
  ['Starting at 11pm or later', late.length ? plural(late.length, 'party', 'parties') : ''],
  ['Under 21', young.length ? young.slice(0, 3).map((p) => `${at(p)} (${p.age_min ? `${p.age_min}+` : 'all ages'})`).join('; ') : n ? 'Every party listed for this night is 21+ or does not state an age.' : ''],
  ['Sold out', soldOut ? plural(soldOut, 'party', 'parties') : ''],
] as [string, string][]).filter(([, v]) => v) : [];
const faq = n ? [
  { q: `What parties are on in NYC on ${monthDay}?`, a: `${plural(n, 'party', 'parties')} are listed, including ${ps.slice(0, 3).map((p) => `${cleanTitle(p.title)} at ${venueOf(p, venues)?.name ?? 'a NYC venue'}${nyTime(p.doors_at ?? p.starts_at) ? ` (doors ${nyTime(p.doors_at ?? p.starts_at)})` : ''}`).join('; ')}.` },
  ...(priced.length ? [{ q: `How much are party tickets in NYC on ${monthDay}?`, a: `The cheapest tickets listed run from $${Math.round(Math.min(...priced))} to $${Math.round(Math.max(...priced))}${free ? `, and ${free} ${free === 1 ? 'party is' : 'parties are'} free` : ''}, fees included where the seller shows them, as of when we checked.` }] : []),
  ...(byBorough.length > 1 ? [{ q: `Where are the parties in NYC on ${monthDay}?`, a: `${byBorough.map(([b, c]) => `${c} in ${b}`).join(', ')}${byHood.length ? `. By neighborhood: ${byHood.slice(0, 4).map(([h, c]) => `${h} (${c})`).join(', ')}` : ''}.` }] : []),
  ...(cheap.length ? [{ q: `What is the cheapest party in NYC on ${monthDay}?`, a: `${freeNights.length ? `${plural(freeNights.length, 'party is', 'parties are')} free, including ${at(freeNights[0])}. ` : ''}The cheapest ticketed: ${cheap.map((p) => `${at(p)}, ${priceLabel(p).toLowerCase()}`).join('; ')}. Prices are the lowest listed when we checked.` }] : []),
  ...(dayParties.length ? [{ q: `Are there day parties in NYC on ${monthDay}?`, a: `Yes, ${dayParties.length}: ${dayParties.slice(0, 3).map((p) => `${at(p)}, from ${nyTime(p.doors_at ?? p.starts_at)}`).join('; ')}.` }] : []),
  ...(young.length ? [{ q: `Are there 18+ parties in NYC on ${monthDay}?`, a: `${plural(young.length, 'party lets', 'parties let')} in guests under 21: ${young.slice(0, 3).map((p) => `${at(p)} (${p.age_min ? `${p.age_min}+` : 'all ages'})`).join('; ')}. The rest are 21+ or do not state an age.` }] : []),
] : [];
// our picks, as on the list pages: the nights people opened and clicked through most this month (proof.json);
// people see about the first screen (Clarity: 24% average scroll depth), so the picks come first
const pr = (proof.pages ?? {}) as Record<string, { views28?: number; tickets28?: number }>;
const score = (p: (typeof ps)[number]) => { const x = pr[`/parties/${p.slug}`] ?? {}; return (x.tickets28 ?? 0) * 10 + (x.views28 ?? 0); };
const picks = !page.past && n >= 6 ? [...ps].filter((p) => p.event_status !== 'sold_out' && score(p) > 0).sort((a, b) => score(b) - score(a) || a.starts_at.localeCompare(b.starts_at)).slice(0, 3) : [];
const top = venueIds.map((id) => venues.find((v) => v.id === id)).filter((v): v is Venue => !!v).slice(0, 5);
---
<Base title={`NYC Parties on ${long}: ${n} ${n === 1 ? 'Party' : 'Parties'}`} titles={[`NYC Parties ${nightDate(page.date, { month: 'short', day: 'numeric' })}: ${n} ${n === 1 ? 'Party' : 'Parties'}`]} keyword={kw} description={description} noindex={!page.indexable} googleNoindex={!page.google}
  jsonld={[crumbs([['YaY NYC', '/'], ['Parties', '/parties'], [long, `/parties/date/${page.date}`]]), collectionLd(`NYC parties on ${long}`, `/parties/date/${page.date}`, ps.map((p) => `/parties/${p.slug}`)), ...(faq.length ? [faqLd(faq)] : [])]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/parties">Parties</a></li>{dayList && <li><a href={`/parties/${dayList.slug}`}>{D}s</a></li>}<li aria-current="page">{nightDate(page.date, { month: 'short', day: 'numeric' })}</li></ol></nav>
  <h1>NYC Parties on {long}</h1>
  <Fresh inShort={inShort} />
  <nav class="date-nav" aria-label="Other nights">
    {prev ? <a href={`/parties/date/${prev.date}`}>← {nightDate(prev.date, { weekday: 'short', month: 'short', day: 'numeric' })}</a> : <span></span>}
    {next ? <a href={`/parties/date/${next.date}`}>{nightDate(next.date, { weekday: 'short', month: 'short', day: 'numeric' })} →</a> : <span></span>}
  </nav>
  {glance.length > 0 && (
    <section class="section card glance">
      <h2>The night at a glance</h2>
      <dl class="facts">{glance.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </section>
  )}
  {picks.length > 0 && (
    <section class="section picks-top">
      <h2>Our picks for {nightDate(page.date, { weekday: 'long' })}</h2>
      <p class="small">The nights people opened and bought tickets for most this month.</p>
      <div class="xgrid">{picks.map((p, i) => <PartyCard party={p} venue={venueOf(p, venues)} eager={i < 2} />)}</div>
    </section>
  )}
  {n > 0 && picks.length > 0 && <h2 class="section">Every party on {monthDay}</h2>}
  {n > 0 && <div class="xgrid">{ps.filter((p) => !picks.includes(p)).map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}</div>}
  {standIns.length > 0 && (
    <section class="section">
      <h2>Next {D} nights</h2>
      <div class="xgrid">{standIns.map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}</div>
    </section>
  )}
  {!page.past && <HappyHourBefore venues={top} heading={`Happy hour before, on a ${D}`} day={dow} />}
  {faq.length > 0 && (
    <section class="section faq">
      <h2>Questions</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
  )}
  <p class="section">{whenLinks.map(([href, text]) => <><a href={href}>{text}</a> · </>)}{dayList && <><a href={`/parties/${dayList.slug}`}>{D} night parties</a> · </>}<a href="/parties">All parties</a></p>
</Base>
<style>
  .glance h2 { margin-top: 0; }
  .date-nav { display: flex; justify-content: space-between; gap: 12px; margin: 8px 0 16px; font-weight: 700; }
</style>
