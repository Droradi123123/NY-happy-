---
import Base from '../../../layouts/Base.astro';
import Fresh from '../../../components/Fresh.astro';
import PartyCard from '../../../components/PartyCard.astro';
import MiniMap from '../../../components/MiniMap.astro';
import Photo from '../../../components/Photo.astro';
import { partyData, googleInfo, placeUrl, placePhoto, photoNote, venueOf, GENRE_NAME, type Party, type Venue, type GoogleInfo } from '../../../lib/data';
import { crumbs, itemList, faqLd, postalAddress, SITE } from '../../../lib/seo';
import HappyHourBefore from '../../../components/HappyHourBefore.astro';
import { venueBars } from '../../../lib/venueBars';
import { cleanTitle, nightDate, nyTime } from '../../../lib/data';
import { dateRange } from '../../../lib/partyLists';
import { venues as actVenues, trivia as actTrivia, bingo as actBingo, games as actGames, sourceLabel, GAME_NAME } from '../../../lib/activities';
import { DAY_NAME, DAYS } from '../../../lib/data';

/** every club that has had a published night keeps its page, with or without parties right now */
export async function getStaticPaths() {
  const { parties, venues, venuePages } = await partyData();
  const google = await googleInfo();
  return venuePages.map((venue) => ({ params: { id: venue.id }, props: { venue, nights: parties.filter((p) => p.venue_id === venue.id), parties, venues, g: google.get(`venue:${venue.id}`) ?? null } }));
}
const { venue: v, nights, parties, venues, g } = Astro.props as { venue: Venue; nights: Party[]; parties: Party[]; venues: Venue[]; g: GoogleInfo | null };

const where = v.neighborhood ?? v.borough ?? 'NYC';
// trivia and games published for this venue (only reviewed public records)
const actKeys = new Set(Object.entries(actVenues).filter(([, a]) => a.partyVenue === v.id).map(([k]) => k));
const actNights = [...actTrivia, ...actBingo].filter((t) => actKeys.has(t.v)).sort((p, q) => DAYS.indexOf(p.day) - DAYS.indexOf(q.day));
const actGamesHere = actGames.filter((a) => actKeys.has(a.v));
const x = (v.extra ?? {}) as Record<string, any>;
const vp = placePhoto('venue', v.id, v.neighborhood, null, true, v.borough);
const website: string | null = x.website ?? null;
const genres = [...new Set(nights.flatMap((p) => p.genres))].slice(0, 5).map((g) => GENRE_NAME[g] ?? g);
const elsewhere = parties.filter((p) => p.venue_id !== v.id && (p.borough === v.borough || !v.borough)).slice(0, 6);
const description = nights.length
  ? `${v.name} events, ${where}: ${nights.length} upcoming night${nights.length === 1 ? '' : 's'} (${dateRange(nights)})${genres.length ? `, ${genres.slice(0, 3).join(', ')}` : ''}, with doors, age and tickets.`
  : `${v.name} events, ${where}: no nights listed right now. Address, how to get there, and other NYC parties coming up.`;
const inShort = nights.length
  ? `${v.name}${v.neighborhood ? ` in ${v.neighborhood}` : ''} has ${nights.length} upcoming night${nights.length === 1 ? '' : 's'} listed (${dateRange(nights)})${genres.length ? `, mostly ${genres.slice(0, 3).join(', ')}` : ''}.`
  : `No nights are listed at ${v.name} right now; new ones appear here when tickets go on sale.`;
// questions answered from the listed nights only (no hours or ratings we have not read)
const ages = [...new Set(nights.map((p) => p.age_min).filter((a): a is number => a !== null))].sort((a, b) => a - b);
const priced = nights.filter((p) => p.price_from !== null && p.price_status !== 'free').map((p) => p.price_from!);
const faq = [
  ...(v.address ? [{ q: `Where is ${v.name}?`, a: `${v.address.replace(/, United States$|, USA$/, '')}${v.neighborhood ? `, in ${v.neighborhood}` : ''}${v.borough && v.borough !== v.neighborhood ? `, ${v.borough}` : ''}.` }] : []),
  { q: `What's on at ${v.name}?`, a: nights.length ? `${nights.length} upcoming ${nights.length === 1 ? 'night' : 'nights'}: ${nights.slice(0, 3).map((p) => `${cleanTitle(p.title)}, ${nightDate(p.night_date, { weekday: 'short', month: 'short', day: 'numeric' })}${nyTime(p.doors_at ?? p.starts_at) ? ` (doors ${nyTime(p.doors_at ?? p.starts_at)})` : ''}`).join('; ')}.` : `No nights are listed right now; new ones appear on this page when tickets go on sale.` },
  ...(genres.length ? [{ q: `What music plays at ${v.name}?`, a: `The nights listed now: ${genres.join(', ')}. Each night's page has its lineup.` }] : []),
  ...(ages.length ? [{ q: `What is the age limit at ${v.name}?`, a: ages.length === 1 ? `${ages[0]}+ for every night listed now. Bring a government photo ID.` : `It depends on the night: from ${ages[0]}+ to ${ages[ages.length - 1]}+ for the nights listed now. Bring a government photo ID.` }] : []),
  ...(priced.length ? [{ q: `How much are tickets at ${v.name}?`, a: `From $${Math.round(Math.min(...priced))} to $${Math.round(Math.max(...priced))} for the cheapest ticket on each night listed now, fees included where the seller shows them.` }] : []),
];
const barsPage = (await venueBars()).find((x) => x.venue.id === v.id) ?? null;
const placeLd = {
  '@context': 'https://schema.org', '@type': v.kind === 'club' || v.kind === 'nightclub' ? 'NightClub' : 'Place', name: v.name, url: `${SITE}/parties/venue/${v.id}`,
  ...(v.address ? { address: postalAddress(v) } : {}), ...(v.lat ? { geo: { '@type': 'GeoCoordinates', latitude: v.lat, longitude: v.lng } } : {}),
  ...(website ? { sameAs: [website] } : {}),
};
---
<Base title={`${v.name} Events: Upcoming Parties and Tickets`} keyword={`${v.name} events`} description={description}
  jsonld={[placeLd, crumbs([['YaY NYC', '/'], ['Parties', '/parties'], [v.name, `/parties/venue/${v.id}`]]), ...(nights.length ? [itemList(`Parties at ${v.name}`, nights.map((p) => `/parties/${p.slug}`))] : []), faqLd(faq)]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/parties">Parties</a></li><li aria-current="page">{v.name}</li></ol></nav>
  <h1>{v.name} Events and Parties</h1>
  <Fresh inShort={inShort} />
  <p class="lede">{v.address?.replace(/, United States$|, USA$/, '')}{v.rooms.length > 0 && ` · Rooms: ${v.rooms.join(', ')}`}</p>
  {vp && <Photo photo={vp.photo} note={photoNote(vp, v.name)} alt={vp.rel === 'own' ? `${v.name}, ${where}` : vp.rel === 'nearby' ? `The street outside ${v.name}, ${where}` : `${where}, the neighborhood around ${v.name}`} hero />}
  {v.lat && <MiniMap lat={v.lat} lng={v.lng!} label={v.name} />}
  {v.copy?.about && <section class="section"><h2>About {v.name}</h2><p>{v.copy.about}</p></section>}
  {(website || g) && (
    <section class="section">
      <h2>Before you go</h2>
      <dl class="facts">
        {v.address && <><dt>Address</dt><dd>{v.address.replace(/, United States$|, USA$/, '')}</dd></>}
        <dt>Door times</dt><dd>Each night has its own, listed on its page.</dd>
      </dl>
      <div class="actions">
        {website && <a class="btn ghost" href={website} rel="noopener" target="_blank">Website</a>}
        {g && <a class="btn ghost" href={placeUrl(v.name, g.place_id)} rel="noopener" target="_blank">Google Maps</a>}
      </div>
    </section>
  )}
  {(actNights.length > 0 || actGamesHere.length > 0) && (
    <section class="section" id="trivia-games">
      <h2>{actNights.length ? 'Trivia' : 'Games'}{actNights.length && actGamesHere.length ? ' and games' : ''} at {v.name}</h2>
      <ul class="acts">
        {actNights.map((t) => <li><strong>{t.kind === 'music_bingo' ? 'Music bingo' : 'Trivia'}: {DAY_NAME[t.day]}s{t.startLabel ? `, ${t.startLabel}` : ''}</strong><span class="small"> · {t.rec}</span><p class="small act-src">Listed by {t.sources.map((x, i) => <>{i > 0 && ', '}{x.url ? <a href={x.url} rel="nofollow noopener" target="_blank">{sourceLabel(x)}</a> : sourceLabel(x)}</>)}</p></li>)}
        {actGamesHere.length > 0 && <li><strong>Games: {actGamesHere.map((a) => GAME_NAME[a.cat] ?? a.game).join(', ')}</strong><p class="small act-src">Per {[...new Map(actGamesHere.flatMap((a) => a.sources).filter((x) => x.url).map((x) => [x.url, x])).values()].map((x, i) => <>{i > 0 && ', '}<a href={x.url!} rel="nofollow noopener" target="_blank">{x.name}</a></>)}. Check with the venue before you go.</p></li>}
      </ul>
      <p class="small"><a href="/trivia">All NYC trivia nights</a> · <a href="/bars-with-games">Bars with games</a></p>
    </section>
  )}
  {nights.length > 0 ? (
    <>
      <h2 class="section">Upcoming at {v.name}</h2>
      <div class="xgrid">{nights.map((p) => <PartyCard party={p} venue={v} />)}</div>
    </>
  ) : (
    <section class="section">
      <h2>No parties listed at {v.name} right now</h2>
      <p>We check ticket pages every day; new nights appear here as soon as they go on sale.</p>
    </section>
  )}
  <HappyHourBefore venues={[v]} heading={`Happy hour before ${v.name}`} max={1} />
  {barsPage && <p><a href={`/parties/venue/${v.id}/bars`}>All {barsPage.bars.length} bars with happy hour near {v.name}</a></p>}
  <section class="section faq">
    <h2>Questions</h2>
    {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
  <p class="small">Something wrong about {v.name}? <a href={`/contact?place=${encodeURIComponent(v.name)}`}>Tell us</a>.</p>
  {elsewhere.length > 0 && (
    <section class="section">
      <h2>More parties{v.borough ? ` in ${v.borough}` : ''}</h2>
      <div class="xgrid">{elsewhere.map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}</div>
    </section>
  )}
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .acts { padding-left: 18px; }
  .acts li { margin: 6px 0; }
  .act-src { margin: 2px 0 0; color: var(--muted); overflow-wrap: anywhere; }
  .act-src a { color: inherit; }
</style>
