---
import Base from '../../layouts/Base.astro';
import PartyCard from '../../components/PartyCard.astro';
import MiniMap from '../../components/MiniMap.astro';
import Photo from '../../components/Photo.astro';
import { partyData, placePhoto, photoNote, venueOf, cleanTitle, nightDate, nyTime, nyDate, priceLabel, fmtDate, GENRE_NAME, allBars, meters, dealLabel, windowLabel, DAYS, type Party, type Venue } from '../../lib/data';
import { tier } from '../../lib/lists';
import { partyTitle, partyName, partyDescription, partyJsonLd, crumbs, faqLd, SITE } from '../../lib/seo';
import { halloweenPages } from '../../lib/halloween';

export async function getStaticPaths() {
  const { parties, venues } = await partyData();
  const names = new Map<string, number>();
  const nights = new Map<string, number>();
  for (const p of parties) {
    const n = partyName(p).toLowerCase();
    names.set(n, (names.get(n) ?? 0) + 1);
    nights.set(`${n}|${p.night_date}`, (nights.get(`${n}|${p.night_date}`) ?? 0) + 1);
  }
  return parties.map((party) => ({ params: { slug: party.slug }, props: { party, venue: venueOf(party, venues), parties, venues,
    recurring: (names.get(partyName(party).toLowerCase()) ?? 0) > 1,
    // several parties with one generic name on the same night ("Halloween", Oct 31): the venue tells them apart
    crowded: (nights.get(`${partyName(party).toLowerCase()}|${party.night_date}`) ?? 0) > 1 } }));
}
const { party: p, venue: v, parties, venues, recurring, crowded } = Astro.props as { party: Party; venue: Venue | null; parties: Party[]; venues: Venue[]; recurring: boolean; crowded: boolean };
const vp = v ? placePhoto('venue', v.id, v.neighborhood ?? p.neighborhood, null, true, v.borough ?? p.borough) : null;
// a party that repeats (same name, several nights) targets "<name> <Oct 24>" on each night's page
const kw = crowded && v ? `${partyName(p)} ${v.name}` : `${partyName(p)}${recurring ? ` ${nightDate(p.night_date, { month: 'short', day: 'numeric' })}` : ''}`;
const url = `${SITE}/parties/${p.slug}`;
const c = p.copy ?? {};
const x = (p.extra ?? {}) as Record<string, any>;
const doors = nyTime(p.doors_at ?? p.starts_at), ends = nyTime(p.ends_at);
const endsAt = p.ends_at ?? new Date(new Date(p.starts_at).getTime() + 6 * 3600e3).toISOString();
const endsNextDay = p.ends_at && nyDate(p.ends_at, { month: 'short', day: 'numeric' }) !== nyDate(p.starts_at, { month: 'short', day: 'numeric' });
const host = (u: string) => { try { return new URL(u).host.replace(/^www\./, ''); } catch { return u; } };
const sameNight = parties.filter((o) => o.slug !== p.slug && o.night_date === p.night_date).slice(0, 6);
const atVenue = parties.filter((o) => o.slug !== p.slug && o.venue_id === p.venue_id).slice(0, 4);
// "Add to calendar": Google Calendar link and an .ics file, both built here (nothing is sent anywhere)
const calStart = new Date(p.doors_at ?? p.starts_at), calEnd = new Date(p.ends_at ?? Date.parse(p.doors_at ?? p.starts_at) + 5 * 3600e3);
const utc = (d: Date) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
const calTitle = cleanTitle(p.title), calWhere = [v?.name, v?.address?.replace(/, United States$|, USA$/, '')].filter(Boolean).join(', ');
const calText = `Tickets and details: ${SITE}/parties/${p.slug}`;
const gcal = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(calTitle)}&dates=${utc(calStart)}/${utc(calEnd)}&location=${encodeURIComponent(calWhere)}&details=${encodeURIComponent(calText)}`;
const icsEsc = (t: string) => t.replace(/[\\;,]/g, (m) => `\\${m}`).replace(/\n/g, '\\n');
const ics = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//YaY NYC//Parties//EN', 'BEGIN:VEVENT', `UID:${p.slug}@yaynyc.com`, `DTSTAMP:${utc(new Date())}`, `DTSTART:${utc(calStart)}`, `DTEND:${utc(calEnd)}`, `SUMMARY:${icsEsc(calTitle)}`, `LOCATION:${icsEsc(calWhere)}`, `DESCRIPTION:${icsEsc(calText)}`, `URL:${SITE}/parties/${p.slug}`, 'END:VEVENT', 'END:VCALENDAR'].join('\r\n');
const icsHref = `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}`;
const lastSeen = p.sources?.find((s) => s.name === 'DICE' || s.name === p.ticket_vendor)?.checked_at ?? p.last_checked;
// one answer-first sentence with the facts people (and AI answers) look for: what, where, when, age, price
const where = v ? `${v.name}${p.neighborhood ? ` in ${p.neighborhood}` : ''}${p.borough && p.borough !== p.neighborhood ? `, ${p.borough}` : ''}` : (p.neighborhood ?? 'a New York venue');
const music = p.genres.slice(0, 3).map((g) => GENRE_NAME[g] ?? g).join(', ');
const summary = [
  `${partyName(p)} is ${music ? `${/^[aeiou]/i.test(music) ? 'an' : 'a'} ${music} party` : 'a party'} at ${where} on ${nightDate(p.night_date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}.`,
  doors ? `Doors ${doors}${ends ? `, ends ${ends}${endsNextDay ? ' the next morning' : ''}` : ''}.` : '',
  p.age_min ? `${p.age_min}+ with ID.` : '',
  p.event_status === 'sold_out' ? 'Sold out when we last checked.' : p.price_status === 'free' ? `Free to enter${p.ticket_vendor ? ` (RSVP on ${p.ticket_vendor})` : ''}.` : p.price_from ? `Tickets from $${Math.round(p.price_from)} on ${p.ticket_vendor} when checked ${fmtDate(lastSeen)}.` : '',
].filter(Boolean).join(' ');
const extraFaq = [
  ...(v ? [{ t: /where|address|location|venue/i, q: `Where is ${partyName(p)}?`, a: `At ${v.name}${v.address ? `, ${v.address.replace(/, United States$|, USA$/, '')}` : ''}${p.neighborhood ? ` (${p.neighborhood})` : ''}.` }] : []),
  ...(p.price_status === 'free' || p.price_from ? [{ t: /price|cost|how much|ticket/i, q: 'How much are tickets?', a: p.price_status === 'free' ? `Free to enter per the listing on ${p.ticket_vendor}.` : `From $${Math.round(p.price_from!)} including fees on ${p.ticket_vendor} when we checked on ${fmtDate(lastSeen)}. Prices rise as tiers sell out.` }] : []),
  ...(music ? [{ t: /music|genre|lineup|dj|who is playing/i, q: 'What kind of music is it?', a: `${music}${p.performers.length ? `, with ${p.performers.slice(0, 4).join(', ')} listed` : ''}, per the ticket listing.` }] : []),
];
// the written FAQ comes first; a generated question is added only when no written one covers its topic
const faq = c.faq?.length ? [...c.faq, ...extraFaq.filter((e) => !c.faq!.some((f) => e.t.test(f.q))).map(({ q, a }) => ({ q, a }))] : [...extraFaq.map(({ q, a }) => ({ q, a })),   { q: 'What time are doors?', a: doors ? `Doors at ${doors}${ends ? `; the listing ends at ${ends}${endsNextDay ? ' the next morning' : ''}` : ''}.` : 'Not listed.' },
  { q: 'What is the age limit?', a: p.age_min ? `${p.age_min}+. Bring a government-issued photo ID.` : 'Not listed: check with the venue.' },
  { q: 'Can I get a refund?', a: p.refund_terms ?? 'Not listed: check the terms on the ticket page.' },
];
// a Halloween night links to the Halloween hub and to every indexed sub-page it appears on
const hw = p.themes.includes('halloween') ? (await halloweenPages()).built.filter((b) => b.indexable && b.parties.some((o) => o.slug === p.slug)) : [];
// before the party: happy hours near the venue that run that night and start before doors, deal read
// recently first, then the closest (walking at about 80 m a minute)
const nyMin = (iso: string) => { const t = Object.fromEntries(new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' }).formatToParts(new Date(iso)).map((x) => [x.type, x.value])); return Number(t.hour) * 60 + Number(t.minute); };
const hm = (t: string | null) => (t ? Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5)) : null);
const nightDay = DAYS[(new Date(`${p.night_date}T12:00:00Z`).getUTCDay() + 6) % 7];
const doorsMin = p.doors_at ?? p.starts_at ? nyMin((p.doors_at ?? p.starts_at)!) : null;
const pregame = v?.lat && v.lng && (doorsMin === null || doorsMin >= 17 * 60)
  ? (await allBars()).filter((b) => b.onMap && b.dealKnown && !b.doubt)
      .map((b) => ({ b, m: meters({ lat: v.lat!, lng: v.lng! }, { lat: b.lat!, lng: b.lng! }), w: b.windows.find((w) => w.days.includes(nightDay) && (w.start === null || doorsMin === null || hm(w.start)! < doorsMin) && (w.end === null || hm(w.end)! >= 16 * 60)) }))
      .filter((x) => x.w && x.m <= 900)
      .sort((a, c) => tier(a.b) - tier(c.b) || a.m - c.m).slice(0, 3)
  : [];
---
<Base title={partyTitle(p, v, crowded)} description={partyDescription(p, v)} keyword={kw} jsonld={[partyJsonLd(p, v, url), crumbs([['YaY NYC', '/'], ['Parties', '/parties'], [cleanTitle(p.title), `/parties/${p.slug}`]]), faqLd(faq)]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/parties">Parties</a></li>{v && <li><a href={`/parties/venue/${v.id}`}>{v.name}</a></li>}<li aria-current="page">{nightDate(p.night_date, { month: 'short', day: 'numeric' })}</li></ol></nav>
  <div class="cols">
    <div>
      <h1><span class="when-big">{nightDate(p.night_date, { weekday: 'long', month: 'short', day: 'numeric' })}{x.multi_day ? ' (multi-day)' : ''}</span> {cleanTitle(p.title)}{crowded && v ? ` at ${v.name}` : ''}</h1>
      <p class="lede summary">{summary}</p>
      <p class="ended-note" hidden data-show-after={endsAt}>This night is over. <a href="/parties">See the next parties in NYC</a>{atVenue.length > 0 && <> or <a href="#at-venue">what is next at this venue</a></>}.</p>
      <div class="tagrow">
        {p.event_status === 'sold_out' && <span class="chip dark">Sold out</span>}
        {p.event_status === 'rescheduled' && <span class="chip dark">Rescheduled: check the date</span>}
        {p.age_min && <span class="chip outline">{p.age_min}+</span>}
        {p.genres.map((g) => <span class="chip">{GENRE_NAME[g] ?? g}</span>)}
        {p.themes.includes('halloween') && <a class="chip" href="/parties/halloween">Halloween</a>}
      </div>

      <section class="ticket card">
        <dl class="facts">
          <dt>Doors</dt><dd>{doors ?? 'not listed'}{ends && <> · ends {ends}{endsNextDay ? ' (next morning)' : ''}</>}</dd>
          <dt>Venue</dt><dd>{v ? <a href={`/parties/venue/${v.id}`}>{v.name}</a> : 'not listed'}{p.room && ` · ${p.room}`}{p.neighborhood && `, ${p.neighborhood}`}</dd>
          {v?.address && <><dt>Address</dt><dd>{v.address.replace(/, United States$|, USA$/, '')}</dd></>}
          {x.entrance && <><dt>Entrance</dt><dd>{x.entrance}</dd></>}
          <dt>Price</dt><dd>{priceLabel(p)}{p.price_from ? ` (lowest ${p.ticket_vendor} ticket incl. fees, seen ${fmtDate(lastSeen)})` : ''}</dd>
          {p.organizer && <><dt>Presented by</dt><dd>{p.organizer}</dd></>}
        </dl>
        {p.event_status !== 'sold_out' && <a class="btn" href={p.ticket_url} rel="nofollow noopener" target="_blank" data-ev="tickets">Tickets on {p.ticket_vendor}</a>}
        {p.event_status === 'sold_out' && <a class="btn ghost" href={p.ticket_url} rel="noopener" target="_blank">Check for resale or waiting list</a>}
        <p class="cal-links">Add to calendar: <a href={gcal} rel="nofollow noopener" target="_blank" data-ev="calendar">Google</a> · <a href={icsHref} download={`${p.slug}.ics`} data-ev="calendar">Apple / Outlook (.ics)</a></p>
      </section>

      {c.about && <section class="section"><h2>About the party</h2><p>{c.about}</p></section>}
      {c.expect && <section class="section"><h2>What to expect</h2><p>{c.expect}</p></section>}
      <section class="section"><h2>Music and lineup</h2>
        {c.music && <p>{c.music}</p>}
        {p.performers.length > 0 && <p><strong>Listed on {p.ticket_vendor}:</strong> {p.performers.join(', ')}.</p>}
        {!c.music && !p.performers.length && <p>The lineup is not listed yet.</p>}
      </section>
      <section class="section"><h2>Before you go</h2>
        {c.before_you_go && <p>{c.before_you_go}</p>}
        <dl class="facts">
          {x.id_required && <><dt>ID</dt><dd>{x.id_required}</dd></>}
          {x.reentry && <><dt>Re-entry</dt><dd>{x.reentry}</dd></>}
          {x.dress && <><dt>Dress</dt><dd>{x.dress}</dd></>}
          {x.photo_policy && <><dt>Photos</dt><dd>{x.photo_policy}</dd></>}
          {x.accessibility && <><dt>Access</dt><dd>{x.accessibility}</dd></>}
          {c.refunds_by_seller ? Object.entries(c.refunds_by_seller).map(([k, val]) => <><dt>Refunds ({k})</dt><dd>{val}</dd></>) : p.refund_terms && <><dt>Refunds</dt><dd>{p.refund_terms}</dd></>}
        </dl>
      </section>
      {pregame.length > 0 && (
        <section class="section pregame">
          <h2>Before the party: happy hours nearby</h2>
          <p class="small">Happy hours within a short walk of {v!.name} that run on {nightDate(p.night_date, { weekday: 'long' })} before doors, with the deal as published.</p>
          <ul>{pregame.map(({ b, m, w }) => <li><a href={`/bars/${b.slug}`} data-ev="pregame"><strong>{b.name}</strong></a> · {Math.max(1, Math.round(m / 80))} min walk<br /><span>{dealLabel(b)}</span> · <span class="muted">{windowLabel(w!)}</span></li>)}</ul>
        </section>
      )}
      <section class="section faq"><h2>Questions</h2>{faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
      <p class="small">Sources: {(p.sources ?? []).filter((s) => s.name !== 'found via').map((s, i) => <>{i > 0 && ', '}<a href={s.url} rel="nofollow noopener" target="_blank">{host(s.url)}</a> ({fmtDate(s.checked_at)})</>)}. Details change: the ticket page has the final word.</p>
    </div>
    <aside>
      {v && vp && <Photo photo={vp.photo} note={photoNote(vp, v.name)} alt={vp.rel === 'own' ? `${v.name}, ${v.neighborhood ?? v.borough ?? 'New York'}` : vp.rel === 'nearby' ? `The street outside ${v.name}` : `${v.neighborhood ?? 'The neighborhood'} around ${v.name}`} ratio="4 / 3" />}
      {v?.lat && <MiniMap lat={v.lat} lng={v.lng!} label={v.name} />}
      {atVenue.length > 0 && <div class="section" id="at-venue"><h2 class="h3">More at {v?.name}</h2><div class="xgrid one">{atVenue.map((o) => <PartyCard party={o} venue={v} />)}</div></div>}
    </aside>
  </div>
  {p.themes.includes('halloween') && (
    <nav class="section" aria-label="More Halloween parties">
      <h2 class="h3">More Halloween parties in NYC</h2>
      <ul class="link-cloud"><li><a href="/parties/halloween">All Halloween parties</a></li>{hw.map((b) => <li><a href={`/parties/halloween/${b.page.slug}`}>{b.page.h1.replace(/,? \d{4}(?=:|$)/, '')}</a></li>)}</ul>
    </nav>
  )}
  {sameNight.length > 0 && <section class="section"><h2>Also on {nightDate(p.night_date, { weekday: 'long' })}</h2><div class="xgrid">{sameNight.map((o) => <PartyCard party={o} venue={venueOf(o, venues)} />)}</div></section>}
</Base>
<style>
  .cal-links { font-size: 14px; color: var(--ink-2); margin: 10px 0 0; }
  .when-big { display: block; font-size: 20px; font-weight: 800; color: var(--coral-ink); margin: 0 0 6px; letter-spacing: 0; }
  .tagrow { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .tagrow a.chip { text-decoration: none; }
  .ticket { background: var(--coral-btn); color: #fff; border: 0; }
  .ticket .btn { margin-top: 16px; }
  .xgrid.one { grid-template-columns: 1fr; }
  .h3 { font-size: 20px; }
  .pregame ul { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 10px; }
  .pregame li { border: 1.5px solid var(--line); border-radius: 12px; padding: 10px 12px; background: #fff; }
  .ended-note { background: var(--coral-soft); border-left: 4px solid var(--coral-btn); padding: 10px 14px; border-radius: 10px; font-weight: 700; }
</style>
