---
import Base from '../../layouts/Base.astro';
import BarCard from '../../components/BarCard.astro';
import Line from '../../components/Line.astro';
import MiniMap from '../../components/MiniMap.astro';
import Photo from '../../components/Photo.astro';
import { allBars, googleInfo, placeUrl, placePhoto, photoNote, copyOf, paragraphs, type PageCopy, DAYS, DAY_NAME, daysLabel, windowLabel, dealLabel, fmtDate, meters, type Bar, type GoogleInfo } from '../../lib/data';
import { hoodHref } from '../../lib/lists';
import { barTitle, barKeyword, barDescription, barJsonLd, crumbs, faqLd, SITE } from '../../lib/seo';
import { venues as actVenues, trivia as actTrivia, bingo as actBingo, games as actGames, sourceLabel, hhOverlap, GAME_NAME } from '../../lib/activities';

export async function getStaticPaths() {
  const bars = await allBars();
  const names = new Map<string, number>();
  for (const b of bars) names.set(b.name.toLowerCase(), (names.get(b.name.toLowerCase()) ?? 0) + 1);
  // a chain's branches each target "<name> <neighborhood> happy hour"
  const google = await googleInfo();
  return Promise.all(bars.map(async (bar) => ({ params: { slug: bar.slug }, props: { bar, bars, hoodUrl: await hoodHref(bar), branch: (names.get(bar.name.toLowerCase()) ?? 0) > 1, g: google.get(`bar:${bar.slug}`) ?? null, copy: await copyOf('bar', bar.slug) } })));
}
const { bar: b, bars, hoodUrl, branch, g, copy } = Astro.props as { bar: Bar; bars: Bar[]; hoodUrl: string; branch: boolean; g: GoogleInfo | null; copy: PageCopy | null };
const url = `${SITE}/bars/${b.slug}`;
const deal = dealLabel(b);
const pp = placePhoto('bar', b.slug, b.hood, b.hoodSlug);
const drinks = b.offers.filter((o) => o.kind === 'drink');
const food = b.offers.filter((o) => o.kind === 'food');
const near = b.onMap
  ? bars.filter((x) => x.slug !== b.slug && x.onMap).map((x) => ({ x, m: meters({ lat: b.lat!, lng: b.lng! }, { lat: x.lat!, lng: x.lng! }) })).filter((n) => n.m < 900).sort((p, q) => p.m - q.m).slice(0, 6)
  : bars.filter((x) => x.slug !== b.slug && x.hoodSlug === b.hoodSlug).slice(0, 6).map((x) => ({ x, m: null }));
const host = (u: string) => { try { return new URL(u).host.replace(/^www\./, ''); } catch { return u; } };
const mapsUrl = g ? placeUrl(b.name, g.place_id) : b.onMap ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${b.name} ${b.address ?? ''}`)}` : null;
// trivia, music bingo and games published for this bar (lib/activities: only reviewed public records)
const actKeys = new Set(Object.entries(actVenues).filter(([, v]) => v.bar === b.slug).map(([k]) => k));
const nights = [...actTrivia, ...actBingo].filter((t) => actKeys.has(t.v)).sort((x, y) => DAYS.indexOf(x.day) - DAYS.indexOf(y.day));
const barGames = actGames.filter((x) => actKeys.has(x.v));
// "confirmed" only when a re-read of the source matched the deal on that date; otherwise it is the date we read it
const confirmed = !!(b.recheck && b.recheck.verdict === 'confirmed' && b.checked && b.recheck.at.slice(0, 10) === b.checked.slice(0, 10));
const faq = [
  { q: `When is happy hour at ${b.name}?`, a: `${b.windows.map((w) => `${daysLabel(w.days)}, ${windowLabel(w)}`).join('; ')}. ${confirmed ? 'Confirmed on' : 'As published on'} ${b.source ? host(b.source) : "the bar's own website"}, read ${fmtDate(b.checked)}.` },
  { q: `What is the happy hour deal at ${b.name}?`, a: deal ? `${deal}.${drinks.length + food.length > 2 ? ' The full list is on this page.' : ''}` : `${b.name} publishes its happy hour times but not what is discounted. Ask the bartender or check their site.` },
  ...(b.subway ? [{ q: `What subway is closest to ${b.name}?`, a: `${b.subway.station} (${b.subway.lines.join(', ')}), about ${b.subway.walk_min} minutes on foot.` }] : []),
  ...(b.booking ? [{ q: `Can I book a table at ${b.name}?`, a: `Yes, ${b.name} takes reservations online. Happy hour deals are often bar-only, so check when you book.` }] : []),
];
for (const f of copy?.faq ?? []) if (!faq.some((x) => x.q.toLowerCase() === f.q.toLowerCase())) faq.push(f);
---
<Base title={barTitle(b, branch)} description={barDescription(b)} keyword={barKeyword(b, branch)} jsonld={[barJsonLd(b, url), crumbs([['YaY NYC', '/'], ['Happy hours', '/happy-hours'], [b.hood, hoodUrl], [b.name, `/bars/${b.slug}`]]), faqLd(faq)]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/happy-hours">Happy hours</a></li><li><a href={hoodUrl}>{b.hood}</a></li><li aria-current="page">{b.name}</li></ol></nav>
  <div class="cols">
    <div>
      <h1>{b.name}{branch && ` ${b.hood}`} Happy Hour</h1>
      <p class="lede">{b.category === 'restaurant' ? 'Restaurant and bar' : b.category === 'pub' ? 'Pub' : 'Bar'} in {b.hood}{b.borough && b.borough !== b.hood ? `, ${b.borough}` : ''}{b.cuisine ? ` · ${b.cuisine}` : ''}</p>

      <section class="dealcard" aria-label="Happy hour">
        <p class="deal-big">{deal ?? 'Happy hour times are published; the deal is not listed'}</p>
        <ul class="windows">
          {b.windows.map((w) => <li><strong>{daysLabel(w.days)}</strong> {windowLabel(w)}<span class="chip badge-live today" data-today={w.days.join(' ')} hidden>Today</span></li>)}
        </ul>
        <p class="checked-line">{confirmed ? <>Deal last confirmed {fmtDate(b.checked)} on </> : <>Deal as published on </>}{b.source ? <a href={b.source} rel="nofollow noopener" target="_blank">{host(b.source)}</a> : "the bar's own website"}{confirmed ? '' : <>, read {fmtDate(b.checked)}</>}. Deals change: confirm before you go.</p>
        {b.doubt === 'changed' && <p class="doubt">When we re-read the bar's page on {fmtDate(b.recheck!.at)}, we could not find these prices there. They may have changed: check with the bar before you go.</p>}
        {b.recheck && b.checked && b.recheck.at.slice(0, 10) > b.checked.slice(0, 10) && (b.recheck.verdict === 'inconclusive' || b.recheck.verdict === 'unreachable') && <p class="checked-line">We tried to re-read it on {fmtDate(b.recheck.at)}, but {b.recheck.verdict === 'unreachable' ? 'the page did not load' : 'the prices there are not in plain text (often a picture of the menu)'}, so the date above is still the last time we saw this deal.</p>}
        {b.doubt === 'partial' && <p class="doubt">When we re-read the bar's page on {fmtDate(b.recheck!.at)}, it still showed {b.recheck!.found!.map((x) => `$${x}`).join(', ')}, but we could not find {b.recheck!.missing!.map((x) => `$${x}`).join(', ')}.</p>}
      </section>

      {copy && (
        <section class="section about">
          <h2>About {b.name}</h2>
          {paragraphs(copy.intro).map((p) => <p>{p}</p>)}
          {copy.sections.map((s) => <><h3>{s.h}</h3>{paragraphs(s.body).map((p) => <p>{p}</p>)}</>)}
        </section>
      )}

      {pp && <Photo photo={pp.photo} note={photoNote(pp, b.name)} alt={pp.rel === 'own' ? `${b.name}, ${b.hood}${pp.photo.title && pp.photo.title !== b.name ? `: ${pp.photo.title}` : ''}` : pp.rel === 'nearby' ? `The street outside ${b.name} in ${b.hood}` : `${b.hood}, the neighborhood around ${b.name}`} />}

      {(drinks.length > 0 || food.length > 0) && (
        <section class="section">
          <h2>What's on the happy hour menu</h2>
          <div class="menu">
            {drinks.length > 0 && <div><h3>Drinks</h3><ul class="menu-list">{drinks.map((o) => <li><span>{o.item}</span><span class="price">{o.price}</span></li>)}</ul></div>}
            {food.length > 0 && <div><h3>Food</h3><ul class="menu-list">{food.map((o) => <li><span>{o.item}</span><span class="price">{o.price}</span></li>)}</ul></div>}
          </div>
          <p class="small">Prices as listed by the bar, before NYC sales tax (8.875%) and tip (18–20% is usual).</p>
        </section>
      )}

      {(nights.length > 0 || barGames.length > 0) && (
        <section class="section" id="trivia-games">
          <h2>{nights.some((t) => t.kind === 'trivia') ? 'Trivia' : nights.length ? 'Music bingo' : 'Games'}{nights.length && barGames.length ? ' and games' : ''} at {b.name}</h2>
          <ul class="acts">
            {nights.map((t) => {
              const ov = hhOverlap(b, t);
              return (
                <li>
                  <strong>{t.kind === 'music_bingo' ? 'Music bingo' : t.musicTrivia ? 'Music trivia' : 'Trivia'}: {DAY_NAME[t.day]}s{t.startLabel ? `, ${t.startLabel}` : ''}</strong>
                  <span class="small"> · {t.rec}{t.host ? ` · Host: ${t.host}` : ''}</span>
                  {ov && <p class={`act-hh ${ov.kind}`}>{ov.label}</p>}
                  <p class="small act-src">Listed by {t.sources.map((x, i) => <>{i > 0 && ', '}{x.url ? <a href={x.url} rel="nofollow noopener" target="_blank">{sourceLabel(x)}</a> : sourceLabel(x)}</>)}</p>
                </li>
              );
            })}
            {barGames.length > 0 && <li><strong>Games: {barGames.map((x) => GAME_NAME[x.cat] ?? x.game).join(', ')}</strong><p class="small act-src">Per {[...new Map(barGames.flatMap((x) => x.sources).filter((x) => x.url).map((x) => [x.url, x])).values()].map((x, i) => <>{i > 0 && ', '}<a href={x.url!} rel="nofollow noopener" target="_blank">{x.name}</a></>)}</p></li>}
          </ul>
          <p class="small">Schedules change: check with {b.name} before you go. <a href="/trivia">All NYC trivia nights</a>{barGames.length > 0 && <> · <a href="/bars-with-games">Bars with games</a></>}</p>
        </section>
      )}

      <section class="section">
        <h2>Before you go</h2>
        <dl class="facts">
          {b.address && <><dt>Address</dt><dd>{b.address}{mapsUrl && <> · <a href={mapsUrl} rel="noopener" target="_blank">Directions</a></>}</dd></>}
          {b.subway && <><dt>Subway</dt><dd>{b.subway.lines.map((l) => <Line l={l} />)} {b.subway.station}, {b.subway.walk_min} min walk{b.subway.accessible ? ' (accessible station)' : ''}</dd></>}
          {b.hours && <><dt>Open</dt><dd><ul class="hours">{DAYS.filter((d) => b.hours![d]).map((d) => <li><span>{DAY_NAME[d]}</span> {b.hours![d]!.split('-').map((t) => t).join('–')}</li>)}</ul></dd></>}
          {b.phone && <><dt>Phone</dt><dd><a href={`tel:${b.phone.replace(/[^\d+]/g, '')}`}>{b.phone}</a></dd></>}
          {b.priceRange && <><dt>Price</dt><dd>{b.priceRange}</dd></>}
          {b.licence && <><dt>Licence</dt><dd>{b.licence} (NY State Liquor Authority, active)</dd></>}
        </dl>
        <div class="actions">
          {b.booking && <a class="btn" href={b.booking} rel="noopener" target="_blank">Book a table</a>}
          {b.website && <a class="btn ghost" href={b.website} rel="noopener" target="_blank">Website</a>}
          {g && <a class="btn ghost" href={placeUrl(b.name, g.place_id)} rel="noopener" target="_blank">Google Maps</a>}
          {b.instagram && <a class="btn ghost" href={b.instagram} rel="noopener" target="_blank">Instagram</a>}
        </div>
      </section>

      <section class="section faq">
        <h2>Questions</h2>
        {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      </section>
    </div>

    <aside>
      {b.onMap && <MiniMap lat={b.lat!} lng={b.lng!} label={b.name} />}
      <div class="card side-card">
        <h2 class="h3">More in {b.hood}</h2>
        <p><a href={hoodUrl}>All happy hours in {b.hood}</a></p>
        {b.subway && <p><a href={`/happy-hours?line=${b.subway.lines[0]}`}>Happy hours on the {b.subway.lines[0]} train</a></p>}
        <p><a href="/contact">Something wrong here? Tell us</a></p>
      </div>
    </aside>
  </div>

  {near.length > 0 && (
    <section class="section">
      <h2>Happy hours nearby</h2>
      <div class="xgrid">{near.map(({ x, m }) => <BarCard bar={x} note={m !== null ? (m < 160 ? `${Math.round(m * 3.28 / 10) * 10} ft` : `${(m / 1609).toFixed(1)} mi`) : undefined} />)}</div>
    </section>
  )}
</Base>
<script>
  // "Today" is New York's weekday in the browser, not the day the page was built
  const d = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'short' }).format(new Date()).toLowerCase().slice(0, 3);
  document.querySelectorAll<HTMLElement>('[data-today]').forEach((el) => { if (el.dataset.today!.split(' ').includes(d)) el.hidden = false; });
</script>

<style>
  .dealcard { background: linear-gradient(135deg, var(--brand-soft) 0%, #FFF 100%); border: 1px solid var(--line); border-radius: 22px; padding: 24px; margin: 18px 0 8px; }
  .deal-big { font-size: clamp(24px, 3.4vw, 34px); font-weight: 800; line-height: 1.12; margin: 0 0 12px; letter-spacing: -0.02em; }
  .windows { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 6px; font-size: 19px; }
  .today { margin-left: 8px; font-size: 13px; }
  .today[hidden] { display: none; }
  .acts { padding-left: 18px; }
  .acts li { margin: 6px 0; }
  .act-hh { margin: 2px 0 0; font-weight: 600; font-size: 15px; }
  .act-hh.during { color: var(--green); }
  .act-src { margin: 2px 0 0; color: var(--muted); overflow-wrap: anywhere; }
  .act-src a { color: inherit; }
  .checked-line { margin: 0; font-size: 15px; }
  .doubt { margin: 6px 0 0; font-size: 15px; background: var(--coral-soft); border-left: 4px solid var(--coral-btn); padding: 8px 12px; border-radius: 8px; }
  .menu { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .menu-list { list-style: none; padding: 0; margin: 0; }
  .menu-list li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed var(--line); }
  .price { font-weight: 800; white-space: nowrap; }
  .hours { list-style: none; padding: 0; margin: 0; }
  .hours span { display: inline-block; width: 100px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .side-card { margin-top: 18px; }
  .h3 { font-size: 20px; }
  aside { min-width: 0; }
</style>
