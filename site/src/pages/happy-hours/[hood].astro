---
import Base from '../../layouts/Base.astro';
import Explorer from '../../components/Explorer.astro';
import BarCard from '../../components/BarCard.astro';
import Photo from '../../components/Photo.astro';
import { allBars, allHoods, dealLabel, photoOf, type Bar, type Hood } from '../../lib/data';
import { stats, plural } from '../../lib/stats';
import { crumbs, faqLd, itemList } from '../../lib/seo';

/** a neighborhood page exists only with 5 or more bars (no thin pages) */
export async function getStaticPaths() {
  const bars = await allBars();
  const hoods = await allHoods();
  return hoods
    .map((hood) => ({ hood, list: bars.filter((b) => b.hoodSlug === hood.slug) }))
    .filter((x) => x.list.length >= 5)
    .map(({ hood, list }) => ({ params: { hood: hood.slug }, props: { hood, list } }));
}
const { hood, list } = Astro.props as { hood: Hood; list: Bar[] };
const s = stats(list);
const ph = photoOf('hood', hood.slug);
const lines = new Map<string, number>();
for (const b of list) for (const l of b.subway?.lines ?? []) lines.set(l, (lines.get(l) ?? 0) + 1);
const topLines = [...lines.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([l]) => l);
const year = new Date().getFullYear();
const faq = [
  { q: `Where is the best happy hour in ${hood.name}?`, a: `We list ${s.n} happy hours in ${hood.name}.${s.cheapestLabel ? ` The cheapest drink on file is ${s.cheapestLabel}.` : ''} ${s.food ? `${s.food} also discount food.` : ''}`.trim() },
  { q: `Are there late-night happy hours in ${hood.name}?`, a: s.late ? `Yes, ${plural(s.late, 'bar')} in ${hood.name} run a happy hour after 9pm. Use the "Late night" filter above.` : `None of the ${hood.name} happy hours we list run after 9pm.` },
  { q: `Which ${hood.name} bars have a weekend happy hour?`, a: s.weekend ? `${plural(s.weekend, 'bar')} run it on Saturday or Sunday; pick the day in the filters.` : `None of the happy hours we list here run on weekends.` },
];
---
<Base title={`Happy Hour in ${hood.name}, NYC: ${s.n} Bars and Deals (${year})`}
  description={`${s.n} happy hours in ${hood.name}, ${hood.borough}, with the deal, times and date checked.${s.cheapestLabel ? ` Cheapest drink: ${s.cheapestLabel}.` : ''} Filter by day, subway line and what's on now.`}
  jsonld={[crumbs([['YaY NYC', '/'], ['Happy hours', '/happy-hours'], [hood.name, `/happy-hours/${hood.slug}`]]), faqLd(faq), itemList(`Happy hours in ${hood.name}`, list.map((b) => `/bars/${b.slug}`))]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/happy-hours">Happy hours</a></li><li aria-current="page">{hood.name}</li></ol></nav>
  <h1>Happy Hour in {hood.name}</h1>
  <p class="lede">{plural(s.n, 'bar')} in {hood.name}, {hood.borough} run a happy hour{s.deals ? `, ${s.deals} with the deal spelled out` : ''}.{s.cheapestLabel && ` The cheapest drink we have on file: ${s.cheapestLabel}.`}{topLines.length > 0 && ` Most are near the ${topLines.join(', ')} trains.`}</p>
  {ph && <div class="hood-hero"><Photo photo={ph} alt={`${hood.name}, ${hood.borough}${ph.title ? `: ${ph.title}` : ''}`} ratio="21 / 9" hero /></div>}
  <Explorer kind="bars" preset={{ hood: hood.slug }} hide={['where']} heading={`Happy hours in ${hood.name}`}>
    {list.slice(0, 24).map((b) => <BarCard bar={b} />)}
  </Explorer>
  <section class="section">
    <h2>Every happy hour in {hood.name}</h2>
    <ul class="all-list">{list.map((b) => <li><a href={`/bars/${b.slug}`}>{b.name}</a>{dealLabel(b) && <span class="small"> · {dealLabel(b)}</span>}</li>)}</ul>
  </section>
  <section class="section faq">
    <h2>{hood.name} happy hour questions</h2>
    {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
</Base>
<style>.all-list { columns: 2 260px; padding-left: 18px; } .all-list li { margin-bottom: 6px; break-inside: avoid; }</style>
