---
/**
 * Neighborhood, borough, deal-type and day pages (lib/lists.ts decides which exist).
 * The opening lines and the answers are computed from the bars on the page, so no two
 * pages read alike and every number on screen is the number in the data.
 */
import Base from '../../layouts/Base.astro';
import Explorer from '../../components/Explorer.astro';
import BarCard from '../../components/BarCard.astro';
import Photo from '../../components/Photo.astro';
import { checkedRange, allBars, allHoods, ampm, dealLabel, scheduleLabel, fmtDate, photoOf, placePhoto, photoNote, boroughSlug, copyOf, paragraphs, readMinutes, DAY_NAME, windowLabel, type Bar, type Day, type PageCopy } from '../../lib/data';
import { listPages, type ListPage } from '../../lib/lists';
import { stats, plural } from '../../lib/stats';
import { crumbs, faqLd, collectionLd, freshDescription } from '../../lib/seo';
import Fresh from '../../components/Fresh.astro';

export async function getStaticPaths() {
  const pages = await listPages();
  return Promise.all(pages.map(async (page) => ({ params: { slug: page.slug }, props: { page, pages, copy: await copyOf(page.kind, page.slug) } })));
}
const { page, pages, copy } = Astro.props as { page: ListPage; pages: ListPage[]; copy: PageCopy | null };
const list = page.bars;
// long lists fold by neighborhood: every bar stays linked in the HTML, the page stays readable
const foldList = page.kind !== 'hood' && list.length > 40;
const byHood = [...list.reduce((m, b) => m.set(b.hood, [...(m.get(b.hood) ?? []), b]), new Map<string, Bar[]>())].sort((a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]));
const s = stats(list);
const year = new Date().getFullYear();
// the month the list was built (it is rebuilt every few hours): shows searchers the list is current
const stamp = `${new Date().toLocaleString('en-US', { month: 'short', timeZone: 'America/New_York' })} ${year}`;
const ph = page.kind === 'hood' ? photoOf('hood', page.slug) : null;
const day = page.kind === 'day' ? (page.preset.day as Day) : null;

// when happy hour starts on this page's bars (on its day, for a day page)
const starts = new Map<string, number>();
for (const b of list) for (const w of b.windows) if (w.start && w.start >= '06:00' && (!day || w.days.includes(day))) starts.set(w.start, (starts.get(w.start) ?? 0) + 1);
const common = [...starts.entries()].sort((a, b) => b[1] - a[1])[0] ?? null;
const earliest = list.flatMap((b) => b.windows.filter((w) => w.start && w.start >= '06:00' && (!day || w.days.includes(day))).map((w) => ({ b, t: w.start! }))).sort((a, b) => a.t.localeCompare(b.t))[0] ?? null;
const lines = new Map<string, number>();
for (const b of list) for (const l of b.subway?.lines ?? []) lines.set(l, (lines.get(l) ?? 0) + 1);
const topLines = [...lines.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([l]) => l);
const hoodCount = new Map<string, number>();
for (const b of list) hoodCount.set(b.hood, (hoodCount.get(b.hood) ?? 0) + 1);
const topHoods = [...hoodCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4);
const best = list.filter((b) => dealLabel(b)).slice(0, 3);
const where = page.kind === 'hood' ? `${page.short}, ${page.borough}` : page.kind === 'borough' ? page.short.replace(/^The /, 'the ') : 'NYC';

const lede = [
  page.kind === 'tag' ? `${plural(s.n, 'bar')} on this list${s.deals ? `, ${s.deals} with the deal spelled out` : ''}.`
    : `${plural(s.n, 'bar')} in ${where} run a happy hour${page.kind === 'day' ? ` on ${page.short}s` : ''}${s.deals ? `, ${s.deals} with the deal spelled out` : ''}.`,
  s.cheapestLabel ? `The cheapest drink we have on file: ${s.cheapestLabel}.` : '',
  common ? `Most start at ${ampm(common[0])}.` : '',
  page.kind !== 'hood' && topHoods.length > 1 ? `Most are in ${topHoods.slice(0, 3).map(([h]) => h).join(', ')}.` : '',
  page.kind === 'hood' && topLines.length ? `Most are near the ${topLines.join(', ')} trains.` : '',
].filter(Boolean).join(' ');

// "sunday happy hour williamsburg": on a neighborhood page, the bars with a Saturday or Sunday happy hour
const weekend = page.kind === 'hood' ? (['sat', 'sun'] as Day[]).map((d) => ({
  d, bars: list.map((b) => ({ b, ws: b.windows.filter((w) => w.days.includes(d)) })).filter((x) => x.ws.length > 0),
})) : [];
const slot = (x: { b: Bar; ws: Bar['windows'] }) => `${x.b.name} (${x.ws.map(windowLabel).join(', ')})`;
const base = page.label.replace(/ in NYC$/, '');
const subject = page.kind === 'tag' ? base[0].toLowerCase() + base.slice(1) : base;
const faq = [
  { q: `Where are the best ${subject}${page.kind === 'tag' || page.kind === 'day' ? ' in NYC' : ''}?`, a: best.length ? `Three with the deal spelled out: ${best.map((b) => `${b.name} (${dealLabel(b)})`).join('; ')}. ${s.cheapestLabel ? `The cheapest drink on file is ${s.cheapestLabel}.` : ''}`.trim() : `We list ${plural(s.n, 'bar')}; open each one for the times and what is discounted.` },
  ...(common ? [{ q: `What time do ${subject} start?`, a: `Most start at ${ampm(common[0])} (${common[1]} of ${s.n}).${earliest ? ` The earliest starts at ${ampm(earliest.t)} at ${earliest.b.name}.` : ''}` }] : []),
  ...(page.kind === 'day' ? [{ q: `Is there happy hour on ${page.short} in NYC?`, a: `Yes. ${plural(s.n, 'bar')} we list run a happy hour on ${page.short}s${s.late ? `, and ${s.late} of them also have a late-night one` : ''}.` }] : []),
  ...(page.kind === 'borough' && topHoods.length ? [{ q: `Which ${page.short.replace(/^The /, '')} neighborhoods have the most happy hours?`, a: topHoods.map(([h, n]) => `${h} (${n})`).join(', ') + '.' }] : []),
  ...(page.kind !== 'tag' || page.slug !== 'late-night' ? [{ q: `Are there late-night ${subject}?`, a: s.late ? `Yes, ${plural(s.late, 'bar')} here ${s.late === 1 ? 'runs' : 'run'} a happy hour after 9pm.` : `None of the ones we list here run after 9pm. See all late-night happy hours in NYC.` }] : []),
  ...weekend.map(({ d, bars }) => ({ q: `Is there a ${DAY_NAME[d]} happy hour in ${page.short}?`, a: bars.length ? `Yes: ${plural(bars.length, 'bar')} here ${bars.length === 1 ? 'runs' : 'run'} a happy hour on ${DAY_NAME[d]}s, including ${bars.slice(0, 3).map(slot).join('; ')}.` : `None of the bars we list in ${page.short} run a happy hour on ${DAY_NAME[d]}s.` })),
  { q: 'What does a happy hour drink really cost in NYC?', a: 'Add NYC sales tax (8.875%) and a tip (18 to 20% is usual) to the menu price. A $6 beer comes to about $7.75.' },
];
// editorial picks: the prose is the writer's, the deal and hours next to it come from live data
const picks = (copy?.picks ?? []).map((p) => ({ b: list.find((x) => x.slug === p.slug), why: p.why })).filter((p): p is { b: Bar; why: string } => !!p.b);
const allFaq = [...(copy?.faq ?? []), ...faq.filter((f) => !(copy?.faq ?? []).some((c) => c.q.toLowerCase() === f.q.toLowerCase()))];

const description = freshDescription(page.label, [
  `${plural(s.n, 'bar')} with the deal, times and date checked.`,
  s.cheapestLabel ? `Cheapest drink: ${s.cheapestLabel}.` : '',
  common ? `Most start at ${ampm(common[0])}.` : '',
  'Filter by day and subway line.',
]);
// the summary an assistant can quote: the computed opening lines (every number from the bars below)
const inShort = lede;
const lastRead = list.map((b) => b.checked).filter(Boolean).sort().pop() ?? null;
const title = page.kind === 'hood' ? `Happy Hour in ${page.short}, NYC: ${s.n} Bars and Deals (${stamp})`
  : page.kind === 'borough' ? `${page.short.replace(/^The /, '')} Happy Hours: ${s.n} Bars, Deals and Times (${stamp})`
  : `${page.h1.replace(/:.*$/, '')}: ${s.n} Bars (${stamp})`;

const groups: [string, ListPage[]][] = [
  ['Boroughs', pages.filter((p) => p.kind === 'borough')],
  ['By deal', pages.filter((p) => p.kind === 'tag')],
  ['By day', pages.filter((p) => p.kind === 'day')],
];
const nearHoods = page.kind === 'hood' ? pages.filter((p) => p.kind === 'hood' && p.borough === page.borough && p.slug !== page.slug) : [];
const crumb: [string, string][] = [['YaY NYC', '/'], ['Happy hours', '/happy-hours'], [page.short, `/happy-hours/${page.slug}`]];
const hoods = (await allHoods()).filter((h) => list.some((b) => b.hoodSlug === h.slug));
---
<Base title={title} description={description} keyword={page.keyword}
  jsonld={[crumbs(crumb), faqLd(allFaq), collectionLd(page.label, `/happy-hours/${page.slug}`, list.map((b) => `/bars/${b.slug}`), lastRead)]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/happy-hours">Happy hours</a></li>{page.kind === 'hood' && page.borough && pages.some((p) => p.kind === 'borough' && p.borough === page.borough) && <li><a href={`/happy-hours/${pages.find((p) => p.kind === 'borough' && p.borough === page.borough)!.slug}`}>{page.borough}</a></li>}<li aria-current="page">{page.short}</li></ol></nav>
  <h1>{page.h1}</h1>
  <Fresh inShort={inShort} />
  {ph && <div class="hood-hero"><Photo photo={ph} alt={`${page.short}, ${page.borough}${ph.title ? `: ${ph.title}` : ''}`} ratio="21 / 9" hero /></div>}
  {copy && (
    <section class="guide-intro">
      <p class="byline">Words by the YaY NYC team, {fmtDate(copy.written)} · Deals last checked on each bar's own site {checkedRange(list)} · {readMinutes(copy)} min read</p>
      {paragraphs(copy.intro).map((p) => <p>{p}</p>)}
    </section>
  )}
  {picks.length > 0 && (
    <section class="section">
      <h2>{page.kind === 'hood' ? `Our picks for happy hour in ${page.short}` : `Our picks: ${subject}`}</h2>
      <ol class="picks">
        {picks.map(({ b, why }, i) => {
          const pp = placePhoto('bar', b.slug, b.hood, b.hoodSlug, false, b.borough);
          return (
            <li class="pick">
              {pp ? <Photo photo={pp.photo} note={photoNote(pp, b.name)} alt={pp.rel === 'own' ? `${b.name}, ${b.hood}` : photoNote(pp, b.name)!} ratio="16 / 9" />
                : <div class={`xcard-art pick-art xart-${boroughSlug(b.borough)}`} aria-hidden="true"><span>{b.name}</span></div>}
              <div class="pick-body">
                <h3><span class="pick-n">{i + 1}.</span> <a href={`/bars/${b.slug}`}>{b.name}</a></h3>
                <p class="pick-facts"><strong>{dealLabel(b) ?? 'Times published, deal not listed'}</strong><br />{scheduleLabel(b)}{b.address ? ` · ${b.address}` : ''}</p>
                <p>{why}</p>
                <p class="small">Deal checked {fmtDate(b.checked)} on the bar's own site.</p>
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  )}
  {copy?.sections.map((s) => <section class="section"><h2>{s.h}</h2>{paragraphs(s.body).map((p) => <p>{p}</p>)}</section>)}
  <Explorer kind="bars" preset={page.preset} hide={page.kind === 'hood' ? ['where'] : []} hoods={hoods} heading={page.label}>
    {list.slice(0, 24).map((b, i) => <BarCard bar={b} eager={i < 2} />)}
  </Explorer>
  {list.length > 24 && (
    <details class="az">
      <summary>All {list.length} happy hours in {page.short}, A to Z</summary>
      <ul class="az-list">{[...list].sort((a, b) => a.name.localeCompare(b.name)).map((b) => <li><a href={`/bars/${b.slug}`}>{b.name}</a>{page.kind !== 'hood' && <span class="az-hood"> · {b.hood}</span>}</li>)}</ul>
    </details>
  )}
  {weekend.some((x) => x.bars.length > 0) && (
    <section class="section" id="weekend">
      <h2>Weekend happy hours in {page.short}</h2>
      {weekend.filter((x) => x.bars.length > 0).map(({ d, bars }) => (
        <>
          <h3 class="h3">{DAY_NAME[d]} happy hours in {page.short} ({bars.length})</h3>
          <ul class="all-list">{bars.map((x) => <li><a href={`/bars/${x.b.slug}`}>{x.b.name}</a><span class="small"> · {x.ws.map(windowLabel).join(', ')}{dealLabel(x.b) ? ` · ${dealLabel(x.b)}` : ''}</span></li>)}</ul>
        </>
      ))}
    </section>
  )}
  <section class="section">
    <h2>All {subject}{page.kind === 'hood' || page.kind === 'borough' ? '' : ' in NYC'} ({s.n})</h2>
    {!foldList ? (
      <ul class="all-list">{list.map((b) => <li><a href={`/bars/${b.slug}`}>{b.name}</a><span class="small"> · {page.kind === 'hood' ? '' : `${b.hood} · `}{dealLabel(b) ?? 'times only'}</span></li>)}</ul>
    ) : (
      <div class="all-groups">{byHood.map(([hood, bs]) => (
        <details>
          <summary>{hood} <span class="count">{bs.length}</span></summary>
          <ul class="all-list">{bs.map((b) => <li><a href={`/bars/${b.slug}`}>{b.name}</a><span class="small"> · {dealLabel(b) ?? 'times only'}</span></li>)}</ul>
        </details>
      ))}</div>
    )}
  </section>
  <section class="section faq">
    <h2>Questions</h2>
    {allFaq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </section>
  {nearHoods.length > 0 && (
    <section class="section">
      <h2>More happy hours in {page.borough}</h2>
      <ul class="link-cloud">{nearHoods.map((p) => <li><a href={`/happy-hours/${p.slug}`}>{p.short}<span class="count">{p.bars.length}</span></a></li>)}</ul>
    </section>
  )}
  <section class="section">
    <h2>More ways to find a happy hour</h2>
    {groups.filter(([, g]) => g.length).map(([name, g]) => (
      <>
        <h3 class="h3">{name}</h3>
        <ul class="link-cloud">{g.filter((p) => p.slug !== page.slug).map((p) => <li><a href={`/happy-hours/${p.slug}`}>{p.short}<span class="count">{p.bars.length}</span></a></li>)}</ul>
      </>
    ))}
    <p><a href="/happy-hours/neighborhoods">All neighborhoods, subway stops and landmarks</a> · <a href="/happy-hours/now">Happy hour right now</a></p>
  </section>
</Base>
<style>
  .all-list { columns: 2 260px; padding-left: 18px; }
  .all-groups { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); align-items: start; }
  .all-groups details { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; }
  .all-groups details[open] { grid-column: 1 / -1; }
  .all-groups summary { font-weight: 800; cursor: pointer; }
  .all-groups .all-list { margin: 10px 0 4px; }
  .all-list li { margin-bottom: 6px; break-inside: avoid; }
  .h3 { margin-top: 18px; }
  .guide-intro { max-width: 70ch; margin: 18px 0 8px; }
  .guide-intro p { font-size: 18px; line-height: 1.6; }
  .byline { font-size: 14px !important; color: var(--muted, #555); margin-bottom: 4px; }
  .picks { list-style: none; padding: 0; margin: 0; display: grid; gap: 28px; }
  .pick { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 22px; align-items: start; }
  .pick :global(.photo) { margin: 0; }
  .pick-art { margin: 0; border-radius: var(--radius); aspect-ratio: 16 / 9; }
  .pick h3 { margin: 0 0 6px; font-size: 22px; }
  .pick-n { color: var(--muted, #555); }
  .pick-facts { margin: 0 0 8px; }
  @media (max-width: 720px) { .pick { grid-template-columns: 1fr; gap: 10px; } }
</style>
