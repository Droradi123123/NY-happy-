---
import Base from '../../layouts/Base.astro';
import Line from '../../components/Line.astro';
import { stations, landmarks } from '../../lib/data';
import { listPages } from '../../lib/lists';
import { crumbs } from '../../lib/seo';

const lists = await listPages();
const counts = new Map(lists.map((l) => [l.slug, l.bars.length]));
const hoods = lists.filter((l) => l.kind === 'hood').map((l) => ({ slug: l.slug, name: l.short, borough: l.borough }));
const boroughPage = (bo: string) => lists.find((l) => l.kind === 'borough' && l.borough === bo);
const byBorough = ['Manhattan', 'Brooklyn', 'Queens', 'The Bronx', 'Staten Island'].map((bo) => ({ bo, page: boroughPage(bo), hoods: hoods.filter((h) => h.borough === bo).sort((a, b) => a.name.localeCompare(b.name)) })).filter((x) => x.hoods.length || x.page);
const st = await stations();
const lm = await landmarks();
---
<Base title="NYC Happy Hours by Neighborhood, Subway Stop and Landmark" keyword="nyc happy hours by neighborhood" description="Find a happy hour by NYC neighborhood, by the subway stop you're at, or near Times Square, Grand Central, Penn Station and other landmarks."
  jsonld={[crumbs([['YaY NYC', '/'], ['Happy hours', '/happy-hours'], ['Neighborhoods', '/happy-hours/neighborhoods']])]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/happy-hours">Happy hours</a></li><li aria-current="page">Neighborhoods</li></ol></nav>
  <h1>NYC Happy Hours by Neighborhood</h1>
  {byBorough.map(({ bo, page, hoods }) => (
    <section class="section"><h2>{page ? <a href={`/happy-hours/${page.slug}`}>{bo} happy hours</a> : bo}</h2>
      <ul class="link-cloud">{hoods.map((h) => <li><a href={`/happy-hours/${h.slug}`}>{h.name}<span class="count">{counts.get(h.slug)}</span></a></li>)}</ul>
    </section>
  ))}
  {lm.length > 0 && <section class="section"><h2>Near a landmark</h2>
    <ul class="link-cloud">{lm.map((l) => <li><a href={`/happy-hours/near/${l.slug}`}>{l.name.replace(/^the /, 'The ')}<span class="count">{l.bars.length}</span></a></li>)}</ul></section>}
  {st.length > 0 && <section class="section"><h2>Near a subway stop</h2>
    <ul class="link-cloud">{st.map((s) => <li><a href={`/happy-hours/near/${s.slug}`}>{s.lines.map((l) => <Line l={l} />)} {s.name}<span class="count">{s.bars.length}</span></a></li>)}</ul></section>}
</Base>
