---
import Base from '../layouts/Base.astro';
import BarCard from '../components/BarCard.astro';
import PartyCard from '../components/PartyCard.astro';
import Logo from '../components/Logo.astro';
import { allBars, allHoods, partyData, venueOf, landmarks } from '../lib/data';
import { stats } from '../lib/stats';
import { SITE } from '../lib/seo';

const bars = await allBars();
const s = stats(bars);
const { parties, venues } = await partyData();
const counts = new Map<string, number>();
for (const b of bars) counts.set(b.hoodSlug, (counts.get(b.hoodSlug) ?? 0) + 1);
const hoods = (await allHoods()).filter((h) => (counts.get(h.slug) ?? 0) >= 5).sort((a, b) => counts.get(b.slug)! - counts.get(a.slug)!).slice(0, 16);
const picks = bars.filter((b) => b.dealKnown && b.cheapestDrink !== null).sort((a, b) => a.cheapestDrink! - b.cheapestDrink!).slice(0, 6);
const halloween = parties.filter((p) => p.themes.includes('halloween'));
const lm = (await landmarks()).slice(0, 8);
---
<Base title="YaY NYC: Happy Hours, Parties and What's On Tonight in New York" description={`All the fun in NYC in one place: ${s.n} verified happy hours with the deal and times, plus parties with doors, age and tickets. Filter by neighborhood, subway line and what's on right now.`}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'YaY NYC', url: SITE, potentialAction: { '@type': 'SearchAction', target: `${SITE}/happy-hours?q={search_term_string}`, 'query-input': 'required name=search_term_string' } }]}>
  <section class="hero">
    <h1>All the fun in NYC, in one place.</h1>
    <p class="lede">{s.n} happy hours with the deal, the time and the date we last checked, plus the parties worth knowing about.</p>
    <form action="/happy-hours" method="get" class="hero-search" role="search">
      <label for="hq" class="sr">Search happy hours</label>
      <input id="hq" name="q" type="search" placeholder="A bar, neighborhood or subway stop" />
      <button class="btn" type="submit">Find</button>
    </form>
    <div class="quick">
      <a class="qcard now" href="/happy-hours/now"><span class="k">Right now</span><span class="t">Happy hour on near you</span></a>
      <a class="qcard dark" href="/parties?when=weekend"><span class="k">This weekend</span><span class="t">Parties with tickets</span></a>
      {halloween.length > 0 && <a class="qcard" href="/parties/halloween"><span class="k">Halloween 2026</span><span class="t">{halloween.length} Halloween parties</span></a>}
      <a class="qcard" href="/map"><span class="k">Map</span><span class="t">Everything on one map</span></a>
    </div>
  </section>

  {picks.length > 0 && (
    <section class="section">
      <h2>Cheapest drinks right now</h2>
      <div class="xgrid">{picks.map((b) => <BarCard bar={b} />)}</div>
      <p class="see-all"><a href="/happy-hours?sort=cheap">See all {s.n} happy hours</a></p>
    </section>
  )}

  {parties.length > 0 && (
    <section class="section">
      <h2>Coming up</h2>
      <div class="xgrid">{parties.slice(0, 6).map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}</div>
      <p class="see-all"><a href="/parties">All parties</a></p>
    </section>
  )}

  <section class="section">
    <h2>Happy hours by neighborhood</h2>
    <ul class="link-cloud">{hoods.map((h) => <li><a href={`/happy-hours/${h.slug}`}>{h.name}<span class="count">{counts.get(h.slug)}</span></a></li>)}</ul>
  </section>
  {lm.length > 0 && (
    <section class="section">
      <h2>Visiting? Happy hours near</h2>
      <ul class="link-cloud">{lm.map((l) => <li><a href={`/happy-hours/near/${l.slug}`}>{l.name.replace(/^the /, 'The ')}</a></li>)}</ul>
    </section>
  )}
  <section class="section how card">
    <h2>How YaY NYC checks</h2>
    <p>Every happy hour is read from the bar's own website or menu, and its page shows the date we checked and a link to the source. When a bar publishes its times but not its prices, we say exactly that instead of guessing. Parties are refreshed from their ticket pages; a night that is over leaves the site.</p>
    <p><a href="/about">More on how we check</a> · <a href="/contact">Report a change</a></p>
  </section>
</Base>
<style>
  .hero { padding: 24px 0 8px; }
  .hero h1 { max-width: 900px; }
  .hero-search { display: flex; gap: 10px; max-width: 720px; margin: 18px 0 22px; }
  .hero-search input { flex: 1; min-width: 0; height: 56px; border: 2px solid var(--ink); border-radius: 14px; padding: 0 18px; font: inherit; font-size: 18px; background: #fff; }
  .hero-search .btn { min-height: 56px; }
  .quick { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .qcard { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: 18px; background: #fff; border: 2px solid var(--ink); text-decoration: none; }
  .qcard .k { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--magenta); }
  .qcard .t { font-size: 22px; font-weight: 800; line-height: 1.15; }
  .qcard.now { background: var(--yellow); border-color: var(--yellow); }
  .qcard.now .k { color: var(--ink); }
  .qcard.dark { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .qcard.dark .k { color: var(--yellow); }
  .qcard:hover { transform: translateY(-2px); }
  .how { background: #fff; }
</style>
