---
/**
 * Home: what is on (now, tonight, the season's big night), the map, the cheapest drinks and the next
 * parties, neighborhoods with photos, guides, the newsletter. Mobile first: one column, big tap targets.
 */
import Base from '../layouts/Base.astro';
import BarCard from '../components/BarCard.astro';
import PartyCard from '../components/PartyCard.astro';
import HomeMap from '../components/HomeMap.astro';
import Newsletter from '../components/Newsletter.astro';
import { allBars, allHoods, partyData, venueOf, landmarks, photoOf, creditShort } from '../lib/data';
import { allGuides, guideCover } from '../lib/guides';
import { stats } from '../lib/stats';
import { SITE } from '../lib/seo';
import { listPages } from '../lib/lists';

const bars = await allBars();
const s = stats(bars);
const { parties, venues } = await partyData();
const counts = new Map<string, number>();
for (const b of bars) counts.set(b.hoodSlug, (counts.get(b.hoodSlug) ?? 0) + 1);
const hoods = (await allHoods()).filter((h) => (counts.get(h.slug) ?? 0) >= 5).sort((a, b) => counts.get(b.slug)! - counts.get(a.slug)!);
const hoodTiles = hoods.filter((h) => photoOf('hood', h.slug)).slice(0, 12);
const picks = bars.filter((b) => b.dealKnown && b.cheapestDrink !== null).sort((a, b) => a.cheapestDrink! - b.cheapestDrink!).slice(0, 10);
const halloween = parties.filter((p) => p.themes.includes('halloween'));
const hwOn = halloween.length > 0 && new Date().toISOString().slice(0, 10) <= '2026-11-01';
const hwPhoto = photoOf('page', 'halloween');
const upcoming = parties.slice(0, 10);
const lm = (await landmarks()).slice(0, 8);
const guides = (await allGuides()).filter((g) => g.status === 'published').sort((a, b) => b.updated.localeCompare(a.updated)).slice(0, 6);
const covers = await Promise.all(guides.map((g) => guideCover(g)));
const onMap = bars.filter((b) => b.onMap).length;
const heroPhoto = photoOf('page', 'home');
const lists = new Map((await listPages()).map((l) => [l.slug, l.bars.length]));
// what are you in the mood for: one tap to each big intent (only pages this build has)
const tag = (slug: string, e: string, t: string) => (lists.has(slug) ? [{ href: `/happy-hours/${slug}`, e, t, n: lists.get(slug), cls: '' }] : []);
const moods = [
  { href: '/happy-hours/now', e: '⏰', t: 'On right now', n: undefined, cls: 'hot' },
  { href: '/parties?when=tonight', e: '🪩', t: 'Parties tonight', n: undefined, cls: '' },
  ...(hwOn ? [{ href: '/parties/halloween', e: '🎃', t: 'Halloween', n: halloween.length, cls: 'hw' }] : []),
  ...tag('cheap-drinks', '💸', 'Cheap drinks'),
  ...tag('rooftop', '🌇', 'Rooftops'),
  ...tag('oysters', '🦪', 'Oysters'),
  ...tag('food', '🍔', 'Food deals'),
  { href: '/map', e: '🗺️', t: 'The map', n: undefined, cls: '' },
  { href: '/happy-hours/neighborhoods', e: '📍', t: 'Neighborhoods', n: hoods.length, cls: '' },
  ...(guides.length ? [{ href: '/blog', e: '📖', t: 'Guides', n: undefined, cls: '' }] : []),
];
const barChips = [
  { href: '/happy-hours?sort=cheap', label: 'Cheapest' }, { href: '/happy-hours/now', label: 'On now' },
  ...[['rooftop', 'Rooftops'], ['food', 'Food deals'], ['brooklyn', 'Brooklyn']].filter(([sl]) => lists.has(sl)).map(([sl, label]) => ({ href: `/happy-hours/${sl}`, label })),
];
---
<Base title="YaY NYC: Happy Hours, Parties and What's On Tonight in New York" keyword="nyc happy hours and parties" description={`NYC happy hours and parties in one place: ${s.n} verified happy hours with the deal and times, plus parties with doors, age and tickets.`}
  ogImage={hwOn && hwPhoto ? hwPhoto.og ?? null : null}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'YaY NYC', url: SITE, potentialAction: { '@type': 'SearchAction', target: `${SITE}/happy-hours?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
    { '@context': 'https://schema.org', '@type': 'Organization', name: 'YaY NYC', url: SITE, logo: `${SITE}/icon-512.png`, slogan: 'All the fun in one place!' }]}>
  {heroPhoto && <link slot="head" rel="preload" as="image" href={heroPhoto.src} imagesrcset={[heroPhoto.mid && `${heroPhoto.mid} 800w`, `${heroPhoto.src} 1280w`].filter(Boolean).join(', ')} imagesizes="100vw" fetchpriority="high" />}
  <section class="hero-x">
    {heroPhoto && <img class="hero-bg" src={heroPhoto.src} srcset={[heroPhoto.mid && `${heroPhoto.mid} 800w`, `${heroPhoto.src} 1280w`].filter(Boolean).join(', ')} sizes="100vw" alt="" width={heroPhoto.w} height={heroPhoto.h} fetchpriority="high" decoding="async" />}
    <div class="hero-in">
      <h1><span class="kicker">NYC happy hours and parties</span> All the fun in one place!</h1>
      <p class="lede">The deal, the hours and the date we checked for {s.n} happy hours, plus {parties.length} parties with doors, age and tickets.</p>
      <form action="/happy-hours" method="get" class="hero-search" role="search">
        <label for="hq" class="sr">Search happy hours</label>
        <input id="hq" name="q" type="search" placeholder="Bar, area or subway stop" />
        <button class="btn coral" type="submit">Search</button>
      </form>
      <ul class="hero-stats">
        <li><b>{s.n}</b> happy hours</li>
        <li><b>{parties.length}</b> parties</li>
        <li><b>{hoods.length}</b> neighborhoods</li>
        <li><b>5</b> boroughs</li>
      </ul>
    </div>
    {heroPhoto && <a class="hero-credit" href={heroPhoto.page} rel="nofollow noopener">{creditShort(heroPhoto)}</a>}
  </section>

  <nav class="moods" aria-labelledby="moods-h">
    <h2 id="moods-h" class="sr">What are you in the mood for?</h2>
    {moods.map((m) => <a class:list={['mood', m.cls]} href={m.href}><span class="e" aria-hidden="true">{m.e}</span><span class="t">{m.t}</span>{m.n !== undefined && <span class="n">{m.n}</span>}</a>)}
  </nav>

  <section class="section rail" data-rail="bars" data-lists={[...lists.keys()].join(",")} aria-labelledby="rb-h">
    <div class="rail-head">
      <h2 id="rb-h">Happy hours in NYC</h2>
      <div class="rail-arrows"><button type="button" data-dir="-1" aria-label="Scroll back">←</button><button type="button" data-dir="1" aria-label="Scroll forward">→</button></div>
    </div>
    <div class="chips-row" data-chips>
      {barChips.map((c, i) => <a href={c.href} aria-current={i === 0 ? 'true' : undefined}>{c.label}</a>)}
    </div>
    <p class="rail-note" data-note aria-live="polite"></p>
    <div class="rail-track" data-track>
      {picks.map((b) => <BarCard bar={b} />)}
      <a class="rail-more" href="/happy-hours"><span>{s.n} happy hours</span><b>See all →</b></a>
    </div>
    <p class="rail-foot"><a data-all href="/happy-hours?sort=cheap">See all {s.n} →</a></p>
  </section>

  {hwOn && (
    <a class="hw-banner" href="/parties/halloween">
      {hwPhoto && <img src={hwPhoto.mid ?? hwPhoto.src} alt="" width={hwPhoto.w} height={hwPhoto.h} loading="lazy" decoding="async" />}
      <span class="hw-text">
        <span class="k">Halloween 2026</span>
        <span class="t">{halloween.length} Halloween parties in NYC, night by night</span>
        <span class="btn coral">See all Halloween parties →</span>
      </span>
      {hwPhoto && <span class="hw-credit">{creditShort(hwPhoto)}</span>}
    </a>
  )}

  {upcoming.length > 0 && (
    <section class="section rail" data-rail="parties" aria-labelledby="rp-h">
      <div class="rail-head">
        <h2 id="rp-h">Parties in NYC</h2>
        <div class="rail-arrows"><button type="button" data-dir="-1" aria-label="Scroll back">←</button><button type="button" data-dir="1" aria-label="Scroll forward">→</button></div>
      </div>
      <div class="chips-row" data-chips>
        <a href="/parties?when=tonight">Tonight</a><a href="/parties?when=weekend">This weekend</a>
        {hwOn && <a href="/parties/halloween">Halloween</a>}<a href="/parties" aria-current="true">All parties</a>
      </div>
      <p class="rail-note" data-note aria-live="polite"></p>
      <div class="rail-track" data-track>
        {upcoming.map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}
        <a class="rail-more" href="/parties"><span>{parties.length} parties</span><b>See all →</b></a>
      </div>
      <p class="rail-foot"><a data-all href="/parties">See all {parties.length} →</a></p>
    </section>
  )}

  <section class="section">
    <h2>The map: every happy hour and party in NYC</h2>
    <p class="sub-lede">{onMap} bars and {parties.length} parties on one map. Tap a dot for the deal or the tickets, or open a full map with filters for day, subway line and price.</p>
    <HomeMap bars={onMap} parties={parties.length} />
  </section>

  <section class="section">
    <div class="rail-head"><h2>Happy hours by neighborhood</h2><a href="/happy-hours/neighborhoods">All neighborhoods</a></div>
    <ul class="tiles">
      {hoodTiles.map((h) => { const ph = photoOf('hood', h.slug)!; return (
        <li><a class="tile" href={`/happy-hours/${h.slug}`}>
          <img src={ph.thumb} alt="" width="500" height="281" loading="lazy" decoding="async" />
          <span class="tile-t">{h.name}<span class="tile-n">{counts.get(h.slug)} happy hours</span></span>
          <span class="tile-c">{creditShort(ph)}</span>
        </a></li>
      ); })}
    </ul>
    <ul class="link-cloud more-hoods">{hoods.filter((h) => !hoodTiles.includes(h)).slice(0, 16).map((h) => <li><a href={`/happy-hours/${h.slug}`}>{h.name}<span class="count">{counts.get(h.slug)}</span></a></li>)}</ul>
  </section>

  {guides.length > 0 && (
    <section class="section">
      <div class="rail-head"><h2>Guides</h2><a href="/blog">All guides</a></div>
      <div class="rail-track">
        {guides.map((g, i) => (
          <article class="xcard guide-card">
            {covers[i] ? <figure class="xcard-img"><img src={covers[i]!.photo.thumb} alt="" width="500" height="281" loading="lazy" decoding="async" /><figcaption>{creditShort(covers[i]!.photo)}</figcaption></figure>
              : <div class="xcard-art" aria-hidden="true"><span>{g.short}</span></div>}
            <h3><a href={`/blog/${g.slug}`}>{g.h1}</a></h3>
            <p class="where">{g.description}</p>
            <p class="xcard-cta" aria-hidden="true">Read the guide <span>→</span></p>
          </article>
        ))}
      </div>
    </section>
  )}

  <div class="section"><Newsletter source="home" /></div>

  {lm.length > 0 && (
    <section class="section">
      <h2>Visiting? Happy hours near</h2>
      <ul class="link-cloud">{lm.map((l) => <li><a href={`/happy-hours/near/${l.slug}`}>{l.name.replace(/^the /, 'The ')}</a></li>)}</ul>
    </section>
  )}
  <section class="section how card">
    <h2>How YaY NYC checks</h2>
    <p>Every happy hour is read from the bar's own website or menu, and its page shows the date we checked and a link to the source. When a bar publishes its times but not its prices, we say exactly that instead of guessing. Parties are refreshed from their ticket pages; a night that is over leaves the site.</p>
    <p><a href="/about">More on how we check</a> · <a href="/contact">Report a change</a></p>
  </section>
</Base>
<script>import '../scripts/rails';</script>
<style>
  /* full-bleed photo hero; body clips the sideways overflow */
  .hero-x { position: relative; margin: -20px calc(50% - 50vw) 0; min-height: 520px; display: flex; align-items: flex-end; background: var(--ink); color: #fff; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .hero-x::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(22,18,43,.25) 0%, rgba(22,18,43,.35) 40%, rgba(22,18,43,.92) 100%); }
  .hero-in { position: relative; z-index: 1; width: 100%; max-width: 1200px; margin: 0 auto; padding: 120px 16px 30px; }
  @media (min-width: 720px) { .hero-x { min-height: 600px; } .hero-in { padding: 160px 32px 48px; } }
  .hero-x h1 { color: #fff; max-width: 820px; text-shadow: 0 2px 14px rgba(0,0,0,.3); }
  .kicker { display: table; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; background: var(--coral-btn); padding: 5px 12px; border-radius: 999px; margin-bottom: 12px; text-shadow: none; }
  .hero-x .lede { color: #EDEAF8; max-width: 640px; }
  .hero-search { display: flex; gap: 8px; max-width: 640px; margin: 16px 0 16px; }
  .hero-search input { flex: 1; min-width: 0; height: 56px; border: 0; border-radius: 16px; padding: 0 16px; font: inherit; font-size: 17px; background: #fff; color: var(--ink); box-shadow: 0 10px 30px rgba(0,0,0,.25); }
  .hero-search input:focus { outline: 3px solid var(--coral); outline-offset: 2px; }
  .hero-search .btn { min-height: 56px; }
  .hero-stats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hero-stats li { background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 6px 12px; border-radius: 999px; font-size: 15px; }
  .hero-stats b { font-weight: 800; }
  .hero-credit { position: absolute; right: 8px; top: 8px; z-index: 1; font-size: 11px; color: #fff; background: rgba(22,18,43,.6); padding: 2px 6px; border-radius: 6px; text-decoration: none; max-width: 70%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .hero-credit:hover { color: #fff; text-decoration: underline; }

  /* mood tiles: one row that scrolls on phones, a grid on desktop */
  .moods { display: grid; grid-auto-flow: column; grid-auto-columns: 112px; gap: 10px; overflow-x: auto; scrollbar-width: none; margin: -26px -16px 0; padding: 0 16px 6px; position: relative; z-index: 2; scroll-snap-type: x proximity; scroll-padding-inline: 16px; }
  .moods::-webkit-scrollbar { display: none; }
  @media (min-width: 720px) { .moods { margin: -34px -32px 0; padding: 0 32px 6px; } }
  @media (min-width: 1100px) { .moods { grid-auto-flow: row; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); overflow: visible; } }
  .mood { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; min-height: 104px; padding: 12px 8px; border-radius: 18px; background: #fff; border: 1px solid var(--line); box-shadow: 0 8px 24px rgba(22,18,43,.10); text-decoration: none; text-align: center; scroll-snap-align: start; transition: transform .15s ease; }
  .mood .e { font-size: 30px; line-height: 1; }
  .mood .t { font-size: 14px; font-weight: 800; line-height: 1.15; color: var(--ink); }
  .mood .n { position: absolute; top: 6px; right: 8px; font-size: 11px; font-weight: 800; color: var(--brand-dark); background: var(--brand-soft); border-radius: 999px; padding: 0 6px; }
  .mood:hover { transform: translateY(-3px); border-color: var(--brand); }
  .mood.hot { background: linear-gradient(135deg, var(--brand) 0%, #8A5CFF 100%); border-color: transparent; }
  .mood.hot .t { color: #fff; }
  .mood.hw { background: var(--ink); border-color: transparent; }
  .mood.hw .t { color: #fff; }
  .mood.hw .n { background: var(--coral-btn); color: #fff; }
  .rail-foot { margin: 0; }
  .rail-foot a { font-weight: 800; text-decoration: none; color: var(--brand); }

  .hw-banner { position: relative; display: block; margin-top: 36px; border-radius: 24px; overflow: hidden; min-height: 260px; text-decoration: none; color: #fff; background: var(--ink); }
  .hw-banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hw-banner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(22,18,43,.92) 0%, rgba(22,18,43,.35) 60%, rgba(22,18,43,.1) 100%); }
  .hw-text { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 10px; padding: 120px 20px 22px; max-width: 640px; }
  .hw-text .k { font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #FF9AA7; }
  .hw-text .t { font-size: clamp(26px, 4vw, 40px); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; }
  .hw-text .btn { align-self: flex-start; }
  .hw-credit { position: absolute; right: 10px; top: 10px; z-index: 1; font-size: 11px; background: rgba(22,18,43,.7); padding: 2px 6px; border-radius: 6px; }
  .hw-banner:hover { color: #fff; }

  .sub-lede { color: var(--ink-2); max-width: 760px; }
  .sec-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .sec-head a { font-weight: 800; white-space: nowrap; text-decoration: none; color: var(--brand); }
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .tiles { grid-template-columns: repeat(4, 1fr); gap: 14px; } }
  .tile { position: relative; display: block; border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; color: #fff; text-decoration: none; background: var(--ink); }
  .tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(22,18,43,.85) 0%, rgba(22,18,43,0) 60%); }
  .tile:hover img { transform: scale(1.04); }
  .tile-t { position: absolute; left: 12px; right: 12px; bottom: 10px; z-index: 1; font-weight: 800; font-size: 18px; line-height: 1.1; }
  .tile-n { display: block; font-size: 13px; font-weight: 600; opacity: 0.9; margin-top: 2px; }
  .tile-c { position: absolute; top: 6px; right: 6px; z-index: 1; font-size: 10px; background: rgba(22,18,43,.6); padding: 1px 5px; border-radius: 5px; max-width: calc(100% - 12px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tile:hover { color: #fff; }
  .more-hoods { margin-top: 14px; }
  .how { background: #fff; }
  .guide-card .where { font-size: 15px; }
</style>
