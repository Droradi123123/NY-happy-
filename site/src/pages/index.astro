---
/**
 * Home, content first: a short hero with the big doors as real buttons, then happy hours (two rows and a
 * button to all), parties (two rows and a button), the season's big night, drinks $6 and under, this
 * weekend's hottest nights, rooftops, the blog, neighborhoods, the map. No search or filters here: they
 * live on /happy-hours and /parties.
 */
import Base from '../layouts/Base.astro';
import BarCard from '../components/BarCard.astro';
import PartyCard from '../components/PartyCard.astro';
import HomeMap from '../components/HomeMap.astro';
import Newsletter from '../components/Newsletter.astro';
import { allBars, allHoods, partyData, venueOf, landmarks, photoOf, creditShort, DAYS, type Party } from '../lib/data';
import { partyLists } from '../lib/partyLists';
import proof from '../data/proof.json';
import { allGuides, guideCover } from '../lib/guides';
import { stats } from '../lib/stats';
import { SITE } from '../lib/seo';
import { listPages, rank } from '../lib/lists';
import { halloweenPages } from '../lib/halloween';
import { trivia, DAY_PAGES, daySlugOf } from '../lib/activities';
import { DAY_NAME } from '../lib/data';

const bars = await allBars();
const s = stats(bars);
const { parties, venues } = await partyData();
const counts = new Map<string, number>();
for (const b of bars) counts.set(b.hoodSlug, (counts.get(b.hoodSlug) ?? 0) + 1);
const hoods = (await allHoods()).filter((h) => (counts.get(h.slug) ?? 0) >= 5).sort((a, b) => counts.get(b.slug)! - counts.get(a.slug)!);
const hoodTiles = hoods.filter((h) => photoOf('hood', h.slug)).slice(0, 12);
const picks = bars.filter((b) => b.dealKnown && b.cheapestDrink !== null).sort((a, b) => a.cheapestDrink! - b.cheapestDrink!).slice(0, 10);
const halloween = parties.filter((p) => p.themes.includes('halloween'));
const hwOn = halloween.length > 0 && new Date().toISOString().slice(0, 10) <= '2026-11-01';
const hwPhoto = photoOf('page', 'halloween');
const hwSubs = hwOn ? (await halloweenPages()).built.filter((b) => b.indexable) : [];
const crawls = (await allGuides()).filter((g) => g.status === 'published' && g.slug.endsWith('-bar-crawl')).sort((a, b) => a.short.localeCompare(b.short));
const lm = (await landmarks()).slice(0, 8);
const guides = (await allGuides()).filter((g) => g.status === 'published').sort((a, b) => b.updated.localeCompare(a.updated)).slice(0, 3);
const covers = await Promise.all(guides.map((g) => guideCover(g)));
const onMap = bars.filter((b) => b.onMap).length;
const listsAll = await listPages();
const lists = new Map(listsAll.map((l) => [l.slug, l.bars.length]));
const plists = await partyLists();

// the season's big night: Halloween until Nov 1, then the nearest holiday page with 5+ nights on sale
const season = hwOn ? { href: '/parties/halloween', label: 'Halloween', n: halloween.length, name: 'Halloween 2026' }
  : (() => { const h = plists.filter((l) => l.kind === 'holiday' && l.holiday && l.parties.length >= 5).sort((a, b) => a.holiday!.date.localeCompare(b.holiday!.date))[0];
      return h ? { href: `/parties/${h.slug}`, label: h.short, n: h.parties.length, name: h.h1.replace(/ in NYC$/, '') } : null; })();

// happy hours first: deals that run today, best first, one per neighborhood
const today = DAYS[(new Date(new Date().toLocaleString('en-US', { timeZone: 'America/New_York' })).getDay() + 6) % 7];
const oneEach = <T,>(xs: T[], key: (x: T) => string, n: number) => { const seen = new Set<string>(), out: T[] = []; for (const x of xs) { const k = key(x); if (seen.has(k)) continue; seen.add(k); out.push(x); if (out.length >= n) break; } return out; };
const ranked = [...bars].filter((b) => b.dealKnown && !b.doubt).sort(rank);
const hhPicks = oneEach([...ranked.filter((b) => b.days.includes(today)), ...ranked], (b) => b.hoodSlug, 6);
// then parties: the next nights people click most (proof.json), one per venue, sold-out last
const pr = (proof.pages ?? {}) as Record<string, { views28?: number; tickets28?: number }>;
const pscore = (p: Party) => { const x = pr[`/parties/${p.slug}`] ?? {}; return (x.tickets28 ?? 0) * 10 + (x.views28 ?? 0); };
const soon = parties.filter((p) => p.event_status !== 'sold_out' && p.night_date <= new Date(Date.now() + 9 * 864e5).toISOString().slice(0, 10));
const partyPicks = oneEach([...soon].sort((a, b) => pscore(b) - pscore(a) || a.starts_at.localeCompare(b.starts_at)), (p) => p.venue_id, 6);
// more sections: cheap drinks, rooftops, this weekend's biggest nights
const cheap = oneEach([...bars].filter((b) => b.dealKnown && !b.doubt && b.cheapestDrink !== null && b.cheapestDrink <= 6).sort((a, b) => a.cheapestDrink! - b.cheapestDrink! || rank(a, b)), (b) => b.hoodSlug, 4);
const rooftops = (listsAll.find((l) => l.slug === 'rooftop')?.bars ?? []).filter((b) => b.dealKnown && !hhPicks.includes(b)).sort(rank).slice(0, 4);
const weekendList = plists.find((l) => l.slug === 'this-weekend');
const weekendPicks = (weekendList?.parties ?? []).filter((p) => !partyPicks.includes(p) && p.event_status !== 'sold_out').sort((a, b) => pscore(b) - pscore(a)).slice(0, 4);
---
<Base title="YaY NYC: Happy Hours, Parties and What's On Tonight in NYC" keyword="nyc happy hours and parties" description={`NYC happy hours and parties in one place: ${s.n} verified happy hours with the deal and times, plus parties with doors, age and tickets.`}
  ogImage={hwOn && hwPhoto ? hwPhoto.og ?? null : null}
  jsonld={[{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'YaY NYC', url: SITE, potentialAction: { '@type': 'SearchAction', target: `${SITE}/happy-hours?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
    { '@context': 'https://schema.org', '@type': 'Organization', name: 'YaY NYC', url: SITE, logo: `${SITE}/icon-512.png`, slogan: 'All the fun in one place!' }]}>
  <section class="hero-x">
    <div class="hero-in">
      <h1><span class="kicker">NYC happy hours and parties</span> All the fun in one place!</h1>
      <p class="lede">{s.n} happy hours with the deal and the hours, and {parties.length} parties with doors, age and tickets.</p>
      <div class="hero-btns">
        <a class="btn" href="/happy-hours">🍸 Happy hours</a>
        <a class="btn coral" href="/parties">🪩 Parties</a>
        {season && <a class="btn dark" href={season.href}>{hwOn ? '🎃' : '🎉'} {season.label}</a>}
        <a class="btn ghost" href="/happy-hours/now">⏰ On right now</a>
      </div>
    </div>
  </section>

  <section class="section home-sec" aria-labelledby="hh-h">
    <div class="sec-head"><h2 id="hh-h">Happy hours today</h2><span class="sec-sub">The best deals running {DAY_NAME[today]}, checked against each bar's own menu</span></div>
    <div class="home-grid">{hhPicks.map((b, i) => <BarCard bar={b} eager={i < 2} />)}</div>
    <a class="btn wide" href="/happy-hours">See all {s.n} happy hours →</a>
  </section>

  {partyPicks.length > 0 && (
    <section class="section home-sec" aria-labelledby="pp-h">
      <div class="sec-head"><h2 id="pp-h">Parties coming up</h2><span class="sec-sub">The nights people are opening most, with doors, age and tickets</span></div>
      <div class="home-grid">{partyPicks.map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}</div>
      <a class="btn coral wide" href="/parties">See all {parties.length} parties →</a>
    </section>
  )}

  {hwOn && (
    <a class="hw-banner" href="/parties/halloween">
      {hwPhoto && <img src={hwPhoto.mid ?? hwPhoto.src} alt="" width={hwPhoto.w} height={hwPhoto.h} loading="lazy" decoding="async" />}
      <span class="hw-text">
        <span class="k">Halloween 2026</span>
        <span class="t">{halloween.length} Halloween parties in NYC, night by night</span>
        <span class="btn coral">See all Halloween parties →</span>
      </span>
      {hwPhoto && <span class="hw-credit">{creditShort(hwPhoto)}</span>}
    </a>
  )}
  {hwSubs.length > 0 && (
    <nav class="section hw-subs" aria-label="Halloween parties by night, borough and kind">
      <ul class="link-cloud">{hwSubs.map((b) => <li><a href={`/parties/halloween/${b.page.slug}`}>{b.page.short === 'Sat Oct 31' || b.page.short === 'Fri Oct 30' ? `Halloween ${b.page.short}` : `${b.page.short} Halloween`}</a></li>)}</ul>
    </nav>
  )}
  {!hwOn && season && (
    <a class="hw-banner season" href={season.href}>
      <span class="hw-text">
        <span class="k">Coming up</span>
        <span class="t">{season.n} {season.name} in NYC</span>
        <span class="btn coral">See all {season.label} parties →</span>
      </span>
    </a>
  )}

  {cheap.length > 0 && (
    <section class="section home-sec" aria-labelledby="ch-h">
      <div class="sec-head"><h2 id="ch-h">💸 Drinks $6 and under</h2><span class="sec-sub">The cheapest happy-hour drinks in the city, as the bars publish them</span></div>
      <div class="home-grid four">{cheap.map((b) => <BarCard bar={b} />)}</div>
      {lists.has('cheap-drinks') && <a class="btn ghost wide" href="/happy-hours/cheap-drinks">All {lists.get('cheap-drinks')} cheap-drink happy hours →</a>}
    </section>
  )}

  {weekendPicks.length > 0 && (
    <section class="section home-sec" aria-labelledby="wk-h">
      <div class="sec-head"><h2 id="wk-h">🔥 This weekend's hottest nights</h2><span class="sec-sub">{weekendList!.title?.replace(/^Parties This Weekend in NYC: /, '') ?? 'Friday to Sunday'}</span></div>
      <div class="home-grid four">{weekendPicks.map((p) => <PartyCard party={p} venue={venueOf(p, venues)} />)}</div>
      <a class="btn ghost wide" href="/parties/this-weekend">Every party this weekend →</a>
    </section>
  )}

  {rooftops.length > 0 && (
    <section class="section home-sec" aria-labelledby="rt-h">
      <div class="sec-head"><h2 id="rt-h">🌆 Rooftop happy hours with a view</h2><span class="sec-sub">Drinks with the skyline, deal included</span></div>
      <div class="home-grid four">{rooftops.map((b) => <BarCard bar={b} />)}</div>
      <a class="btn ghost wide" href="/happy-hours/rooftop">All rooftop happy hours →</a>
    </section>
  )}

  {guides.length > 0 && (
    <section class="section home-sec" aria-labelledby="gd-h">
      <div class="sec-head"><h2 id="gd-h">📖 Fresh from the blog</h2><span class="sec-sub">Guides to going out in NYC, from our own data</span></div>
      <div class="home-grid three">
        {guides.map((g, i) => (
          <article class="xcard guide-card">
            {covers[i] ? <figure class="xcard-img"><img src={covers[i]!.photo.thumb} alt="" width="500" height="281" loading="lazy" decoding="async" /><figcaption>{creditShort(covers[i]!.photo)}</figcaption></figure>
              : <div class="xcard-art" aria-hidden="true"><span>{g.short}</span></div>}
            <h3><a href={`/blog/${g.slug}`}>{g.h1}</a></h3>
            <p class="where">{g.description}</p>
            <p class="xcard-cta" aria-hidden="true">Read the guide <span>→</span></p>
          </article>
        ))}
      </div>
      <a class="btn ghost wide" href="/blog">All guides →</a>
    </section>
  )}

  <section class="section">
    <h2>The map: every happy hour and party in NYC</h2>
    <p class="sub-lede">{onMap} bars and {parties.length} parties on one map. Tap a dot for the deal or the tickets, or open a full map with filters for day, subway line and price.</p>
    <HomeMap bars={onMap} parties={parties.length} />
  </section>

  <section class="section">
    <div class="rail-head"><h2>Happy hours by neighborhood</h2><a href="/happy-hours/neighborhoods">All neighborhoods</a></div>
    <ul class="tiles">
      {hoodTiles.map((h) => { const ph = photoOf('hood', h.slug)!; return (
        <li><a class="tile" href={`/happy-hours/${h.slug}`}>
          <img src={ph.thumb} alt="" width="500" height="281" loading="lazy" decoding="async" />
          <span class="tile-t">{h.name}<span class="tile-n">{counts.get(h.slug)} happy hours</span></span>
          <span class="tile-c">{creditShort(ph)}</span>
        </a></li>
      ); })}
    </ul>
  </section>

  {(crawls.length > 0 || trivia.length > 0) && (
    <section class="section">
      <h2>Bar crawls and trivia nights</h2>
      {crawls.length > 0 && <p class="small">Happy-hour bar crawls, each a short walk between bars whose deals overlap:</p>}
      <ul class="link-cloud">{crawls.map((g) => <li><a href={`/blog/${g.slug}`}>{g.short.replace(/ bar crawl$/, '')}</a></li>)}</ul>
      {trivia.length > 0 && <p class="small">{trivia.length} trivia nights at NYC bars, by night: <a href="/trivia">all trivia nights</a>.</p>}
      <ul class="link-cloud">{DAY_PAGES.map((d) => <li><a href={`/trivia/${daySlugOf(d)}`}>{DAY_NAME[d]} trivia</a></li>)}</ul>
    </section>
  )}

  <div class="section"><Newsletter source="home" /></div>

  {lm.length > 0 && (
    <section class="section">
      <h2>Visiting? Happy hours near</h2>
      <p class="near-line">{lm.map((l, i) => <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={`/happy-hours/near/${l.slug}`}>{l.name.replace(/^the /, 'The ')}</a></>)}</p>
    </section>
  )}
  <section class="section how card">
    <h2>How YaY NYC checks</h2>
    <p>Every happy hour is read from the bar's own website or menu, and its page shows the date we checked and a link to the source. When a bar publishes its times but not its prices, we say exactly that instead of guessing. Parties are refreshed from their ticket pages; a night that is over leaves the site.</p>
    <p>YaY NYC is a free community guide: no one can pay to be listed or ranked, and tips from readers help us find what we are missing.</p>
    <p><a href="/about">More on how we check</a> · <a href="/contact">Share a tip</a></p>
  </section>
</Base>
<style>
  /* a clean hero: no photo, the headline and the search are the page's first frame */
  .hero-x { padding: 28px 0 8px; }
  @media (min-width: 720px) { .hero-x { padding: 56px 0 16px; } }
  .hero-in { max-width: 820px; }
  .hero-x h1 { font-size: clamp(34px, 6vw, 58px); line-height: 1.02; letter-spacing: -0.03em; margin: 0; }
  .kicker { display: table; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand); background: transparent; padding: 0; margin-bottom: 12px; }
  .hero-x .lede { color: var(--ink-2); max-width: 640px; margin: 14px 0 0; }
  /* the big doors: real buttons, 2 x 2 on phones, one row from tablets */
  .hero-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 20px; max-width: 760px; }
  @media (min-width: 720px) { .hero-btns { display: flex; flex-wrap: wrap; gap: 12px; } }
  .hero-btns .btn { min-height: 52px; padding: 0 14px; font-size: 16px; white-space: nowrap; box-shadow: 0 2px 0 rgba(22, 18, 43, 0.18); }
  /* home sections: two rows of cards, then one clear button */
  .home-sec { display: grid; gap: 14px; }
  .sec-head { display: grid; gap: 2px; }
  .sec-head h2 { margin: 0; }
  .sec-sub { color: var(--muted); font-size: 15px; }
  .home-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  /* phones: two compact columns, so two rows of cards fit on about one screen */
  @media (max-width: 639px) {
    .home-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
    .home-grid :global(.xcard) { padding: 10px; gap: 4px; }
    .home-grid :global(.xcard-img), .home-grid :global(.xcard-art) { margin: -10px -10px 4px; }
    .home-grid :global(.xcard-art) { padding: 8px 10px 18px; }
    .home-grid :global(.xcard-art span) { font-size: 17px; }
    .home-grid :global(.xcard h3) { font-size: 15px; line-height: 1.2; }
    .home-grid :global(.xcard .deal) { font-size: 14px; }
    .home-grid :global(.xcard .sch), .home-grid :global(.xcard .when) { font-size: 13px; }
    .home-grid :global(.xcard .where), .home-grid :global(.xcard .checked), .home-grid :global(.xcard .xcard-foot), .home-grid :global(.xcard-img figcaption) { display: none; }
    .home-grid :global(.xcard-cta) { font-size: 13px; padding-top: 6px; flex-wrap: wrap; gap: 4px; }
    .home-grid :global(.xcard-buy) { min-height: 32px; padding: 0 10px; font-size: 13px; }
    .home-grid :global(.xcard-cta > span[aria-hidden]) { display: none; }
  }
  .home-grid > * { min-width: 0; }
  @media (min-width: 640px) { .home-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .home-grid { grid-template-columns: repeat(3, 1fr); } .home-grid.four { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 639px) { .home-grid > :nth-child(n+5) { display: none; } .home-grid.three > :nth-child(n+3) { display: none; } }
  .btn.wide { justify-self: start; }
  @media (max-width: 639px) { .btn.wide { justify-self: stretch; } }
  .hw-banner.season { min-height: 0; background: linear-gradient(135deg, var(--ink), var(--brand-dark)); }
  .hw-banner.season .hw-text { padding: 28px 20px; }

  .near-line { line-height: 1.9; }
  .near-line a { font-weight: 700; }
  .rail-foot { margin: 0; }
  .rail-foot a { font-weight: 800; text-decoration: none; color: var(--brand); }

  .hw-banner { position: relative; display: block; margin-top: 36px; border-radius: 24px; overflow: hidden; min-height: 260px; text-decoration: none; color: #fff; background: var(--ink); }
  .hw-banner img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hw-banner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(22,18,43,.92) 0%, rgba(22,18,43,.35) 60%, rgba(22,18,43,.1) 100%); }
  .hw-text { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 10px; padding: 120px 20px 22px; max-width: 640px; }
  .hw-text .k { font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #FF9AA7; }
  .hw-text .t { font-size: clamp(26px, 4vw, 40px); font-weight: 800; line-height: 1.05; letter-spacing: -0.02em; }
  .hw-text .btn { align-self: flex-start; }
  .hw-credit { position: absolute; right: 10px; top: 10px; z-index: 1; font-size: 11px; background: rgba(22,18,43,.7); padding: 2px 6px; border-radius: 6px; }
  .hw-banner:hover { color: #fff; }

  .sub-lede { color: var(--ink-2); max-width: 760px; }
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  @media (min-width: 900px) { .tiles { grid-template-columns: repeat(4, 1fr); gap: 14px; } }
  .tile { position: relative; display: block; border-radius: 16px; overflow: hidden; aspect-ratio: 4 / 3; color: #fff; text-decoration: none; background: var(--ink); }
  .tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(22,18,43,.85) 0%, rgba(22,18,43,0) 60%); }
  .tile:hover img { transform: scale(1.04); }
  .tile-t { position: absolute; left: 12px; right: 12px; bottom: 10px; z-index: 1; font-weight: 800; font-size: 18px; line-height: 1.1; }
  .tile-n { display: block; font-size: 13px; font-weight: 600; opacity: 0.9; margin-top: 2px; }
  .tile-c { position: absolute; top: 6px; right: 6px; z-index: 1; font-size: 10px; background: rgba(22,18,43,.6); padding: 1px 5px; border-radius: 5px; max-width: calc(100% - 12px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tile:hover { color: #fff; }
  .how { background: #fff; }
  .guide-card .where { font-size: 15px; }
</style>
