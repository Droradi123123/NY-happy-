---
/** One attraction on the hub and category pages. data-* feed the hub filters (category, borough, free, search). */
import { priceFlagLabel, placeLabel, type Attraction } from '../lib/attractions';
import { fmtDate, photoOf, creditShort, boroughSlug } from '../lib/data';
interface Props { a: Attraction }
const { a } = Astro.props;
// the card shows the price summary's first clause (the full summary is on the page)
const price = priceFlagLabel(a).split(/;\s*/)[0];
const place = placeLabel(a);
const photo = photoOf('attraction', a.id);
---
<article class="xcard acard" data-cat={a.catSlug} data-boro={a.borough} data-free={a.price_flag === 'free' ? '1' : '0'} data-q={`${a.name} ${a.neighborhood}`.toLowerCase()}
  data-hours={a.hours ? JSON.stringify(a.hours) : undefined} data-lat={a.geo?.lat} data-lng={a.geo?.lng}>
  {photo && <figure class="xcard-img"><img src={photo.thumb} alt="" width="500" height="281" loading="lazy" decoding="async" /><figcaption>{creditShort(photo)}</figcaption></figure>}
  {!photo && <div class={`xcard-art xart-${boroughSlug(a.borough)}`} aria-hidden="true"><span>{a.neighborhood}</span></div>}
  <p class="acard-cat">{a.catLabel}</p>
  <h3><a href={a.path}>{a.name}</a></h3>
  <p class="acard-place">{place}</p>
  <p class="acard-price">{price}</p>
  <p class="acard-live" data-live hidden></p>
  <p class="acard-checked">Checked {fmtDate(a.verified_at)}</p>
</article>
<style>
  .acard h3 a { color: var(--ink); text-decoration: none; }
  .acard h3 a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .acard-cat { margin: 0; font-size: 13px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; color: var(--brand); }
  .acard-place { margin: 0; color: var(--ink-2); font-size: 15px; }
  .acard-price { margin: 4px 0 0; font-weight: 700; font-size: 15px; overflow-wrap: anywhere; }
  .acard-live { margin: 0; font-size: 14px; font-weight: 700; color: var(--ink-2); }
  .acard-live :global(.on) { color: var(--green); }
  .acard-live :global(.off) { color: var(--muted); }
  .acard-checked { margin: auto 0 0; padding-top: 6px; color: var(--muted); font-size: 13px; }
</style>
