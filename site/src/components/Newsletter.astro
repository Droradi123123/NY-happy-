---
/**
 * Newsletter sign-up. Posts straight to Supabase (newsletter_signups: insert-only for the public key,
 * nobody can read the list through the API). A hidden field catches bots.
 */
interface Props { source: string; compact?: boolean; heading?: string; text?: string }
const { source, compact = false, heading = 'The best of NYC, every Thursday', text = 'The week’s best happy hours, new deals and the parties worth buying tickets for. One email a week, no spam, unsubscribe anytime.' } = Astro.props;
const id = `nl-${source.replace(/[^a-z0-9]+/gi, '-')}`;
---
<section id="newsletter" class:list={['newsletter', { compact }]} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{heading}</h2>
  <p>{text}</p>
  <form class="nl-form" data-nl data-source={source} novalidate>
    <label for={`${id}-e`} class="sr">Email address</label>
    <input id={`${id}-e`} type="email" name="email" placeholder="you@email.com" autocomplete="email" required />
    <input class="nl-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="btn coral" type="submit">Sign me up</button>
  </form>
  <p class="nl-msg" role="status" aria-live="polite"></p>
  <p class="nl-fine">By signing up you agree to get our weekly email. We never share your address. <a href="/privacy">Privacy</a>.</p>
</section>
<script>
  const URL_ = 'https://zqfscuwkxcoktpjhaebv.supabase.co/rest/v1/newsletter_signups';
  const KEY = 'sb_publishable_JxdYGXYsOzPNAC9avS8wfA_SExSJIHc';
  const CONSENT = 'Weekly YaY NYC email; never shared; unsubscribe anytime.';
  document.querySelectorAll<HTMLFormElement>('form[data-nl]').forEach((f) => f.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = f.parentElement!.querySelector<HTMLElement>('.nl-msg')!;
    const email = (f.elements.namedItem('email') as HTMLInputElement).value.trim();
    if ((f.elements.namedItem('website') as HTMLInputElement).value) return; // a bot filled the hidden field
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { msg.textContent = 'Please enter a valid email address.'; return; }
    const btn = f.querySelector('button')!; btn.disabled = true;
    try {
      const r = await fetch(URL_, { method: 'POST', headers: { apikey: KEY, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify({ email, source: `${f.dataset.source} ${location.pathname}`.slice(0, 200), consent_text: CONSENT }) });
      // 409: already on the list, which is fine
      if (r.ok || r.status === 409) {
        msg.textContent = 'You’re in! See you Thursday.'; f.reset();
        (window as any).gtag?.('event', 'sign_up', { method: 'newsletter', source: f.dataset.source });
      } else msg.textContent = 'Something went wrong. Please try again.';
    } catch { msg.textContent = 'Something went wrong. Please try again.'; }
    btn.disabled = false;
  }));
</script>
