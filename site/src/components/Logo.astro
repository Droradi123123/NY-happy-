---
/** The YaY NYC logo: the yellow-Y mark, then the wordmark Y·a·Y (lowercase a in coral) NYC. Exact spelling, always. */
import { markSvg } from '../lib/brand.mjs';
interface Props { size?: number; light?: boolean }
const { size = 34, light = false } = Astro.props;
const mark = markSvg();
---
<span class="logo" style={`font-size:${size}px`} data-light={light ? '' : undefined}>
  <span class="logo-mark" set:html={mark} />
  <span class="logo-yay">Y<span class="logo-a">a</span>Y</span> <span class="logo-nyc">NYC</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.22em; font-weight: 800; line-height: 1; color: var(--ink); white-space: nowrap; }
  .logo-mark { display: inline-flex; width: 1.08em; height: 1.08em; margin: -0.06em 0.04em -0.06em 0; transition: transform 0.25s ease; }
  .logo-mark :global(svg) { width: 100%; height: 100%; display: block; }
  :global(a:hover) > .logo .logo-mark { transform: rotate(-8deg) scale(1.06); }
  .logo-yay { letter-spacing: -0.05em; }
  .logo-nyc { letter-spacing: -0.03em; }
  .logo-a { color: var(--coral); }
  .logo[data-light] { color: #fff; }
  .logo[data-light] .logo-a { color: var(--coral); }
  @media (prefers-reduced-motion: reduce) { .logo-mark { transition: none; } }
</style>
