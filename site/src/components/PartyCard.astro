---
import { cleanTitle, nightDate, nyTime, priceLabel, GENRE_NAME, placePhoto, cardCredit, boroughSlug, ticketHref, TICKET_REL, type Party, type Venue } from '../lib/data';
interface Props { party: Party; venue: Venue | null; eager?: boolean }
const { party: p, venue: v, eager = false } = Astro.props;
// when the night is over (ends_at, or six hours after the start): the page hides the card from then on, rebuild or not
const endsAt = p.ends_at ?? new Date(new Date(p.starts_at).getTime() + 6 * 3600e3).toISOString();
const pp = placePhoto('venue', p.venue_id, v?.neighborhood ?? p.neighborhood, null, false, v?.borough ?? p.borough);
---
<article class="xcard party" data-end={endsAt}>
  {pp && <figure class="xcard-img"><img src={pp.photo.thumb} alt="" width="500" height="281" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" /><figcaption>{cardCredit(pp)}</figcaption></figure>}
  {!pp && <div class={`xcard-art xart-${boroughSlug(p.borough)}`} aria-hidden="true"><span>{v?.name ?? p.neighborhood ?? 'NYC'}</span></div>}
  <div class="xcard-top"><p class="when">{nightDate(p.night_date, { weekday: 'short', month: 'short', day: 'numeric' })}{nyTime(p.doors_at ?? p.starts_at) && ` · ${nyTime(p.doors_at ?? p.starts_at)}`}</p></div>
  <h3><a href={`/parties/${p.slug}`}>{cleanTitle(p.title)}</a></h3>
  <p class="where">{v?.name}{p.neighborhood && ` · ${p.neighborhood}`}</p>
  <div class="xcard-foot">
    {p.event_status === 'sold_out' ? <span class="chip dark">Sold out</span> : <span class="chip outline">{priceLabel(p)}</span>}
    {p.age_min && <span class="chip outline">{p.age_min}+</span>}
    {p.genres.slice(0, 3).map((g) => <span class="chip">{GENRE_NAME[g] ?? g}</span>)}
  </div>
  {/* straight to the seller from a list (one click less), above the card's own link to the party page */}
  {p.event_status !== 'sold_out' && p.ticket_url
    ? <div class="xcard-cta"><a class="xcard-buy" href={ticketHref(p)} rel={TICKET_REL} target="_blank" data-ev="tickets">{p.price_status === 'free' ? 'Free: RSVP' : p.price_from ? `Tickets from $${Math.round(p.price_from)}` : 'Tickets'}</a><span aria-hidden="true">Details →</span></div>
    : <p class="xcard-cta" aria-hidden="true">Details <span>→</span></p>}
</article>
