---
/** Server-rendered twin of explorer.ts barCard(): same markup, so the page does not jump. */
import { dealLabel, scheduleLabel, fmtDate, placePhoto, cardCredit, boroughSlug, type Bar } from '../lib/data';
import Line from './Line.astro';
interface Props { bar: Bar; note?: string; eager?: boolean }
const { bar: b, note, eager = false } = Astro.props;
const deal = dealLabel(b);
const pp = placePhoto('bar', b.slug, b.hood, b.hoodSlug, false);
---
<article class="xcard">
  {pp && <figure class="xcard-img"><img src={pp.photo.thumb} alt="" width="500" height="281" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" /><figcaption>{cardCredit(pp)}</figcaption></figure>}
  {!pp && <div class={`xcard-art xart-${boroughSlug(b.borough)}`} aria-hidden="true"><span>{b.hood}</span></div>}
  <div class="xcard-top"><h3><a href={`/bars/${b.slug}`}>{b.name}</a></h3>{note && <span class="dist">{note}</span>}</div>
  <p class="where">{b.hood}{b.borough && b.borough !== b.hood ? `, ${b.borough}` : ''}</p>
  {deal ? <p class="deal">{deal}</p> : <p class="deal muted">Times published, deal not listed</p>}
  <p class="sch">{scheduleLabel(b)}</p>
  {b.subway && <div class="xcard-foot"><span class="sub">{b.subway.lines.map((l) => <Line l={l} />)} {b.subway.station} · {b.subway.walk_min} min walk</span></div>}
  {b.checked && <p class="checked">Checked {fmtDate(b.checked)?.replace(/, \d{4}$/, '')}</p>}
  <p class="xcard-cta" aria-hidden="true">See the deal <span>→</span></p>
</article>
