---
import MapPoster from './MapPoster.astro';
/**
 * Filters + list + map. The first cards are rendered here (they work without
 * JavaScript and are what search engines read); scripts/explorer.ts takes over in the
 * browser. `preset` fixes filters for a page (a neighborhood page presets hood).
 */
import { GENRE_NAME } from '../lib/data';

interface Props {
  kind: 'bars' | 'parties';
  preset?: Record<string, string | string[]>;
  hide?: string[];
  hoods?: { slug: string; name: string }[];
  genres?: string[];
  venues?: { id: string; name: string }[];
  heading?: string;
  mode?: 'split' | 'list' | 'map';
}
const { kind, preset = {}, hide = [], hoods = [], genres = [], heading, mode = 'split' } = Astro.props;
const show = (k: string) => !hide.includes(k);
const LINES = ['1', '2', '3', '4', '5', '6', '7', 'A', 'C', 'E', 'B', 'D', 'F', 'M', 'G', 'J', 'Z', 'L', 'N', 'Q', 'R', 'W', 'S'];
const LINE_STYLE: Record<string, string> = {};
for (const [ls, bg, fg] of [['123', '#EE352E', '#fff'], ['456', '#00933C', '#fff'], ['7', '#B933AD', '#fff'], ['ACE', '#0039A6', '#fff'], ['BDFM', '#FF6319', '#fff'], ['G', '#6CBE45', '#141414'], ['JZ', '#996633', '#fff'], ['L', '#A7A9AC', '#141414'], ['NQRW', '#FCCC0A', '#141414'], ['S', '#808183', '#fff']])
  for (const l of ls) LINE_STYLE[l] = `background:${bg};color:${fg}`;
const BOROUGHS = ['Manhattan', 'Brooklyn', 'Queens', 'The Bronx', 'Staten Island'];
const DAYS = [['mon', 'Mon'], ['tue', 'Tue'], ['wed', 'Wed'], ['thu', 'Thu'], ['fri', 'Fri'], ['sat', 'Sat'], ['sun', 'Sun']];
const TIMES = [[900, '3pm'], [960, '4pm'], [1020, '5pm'], [1080, '6pm'], [1140, '7pm'], [1200, '8pm'], [1260, '9pm'], [1320, '10pm'], [1380, '11pm']];
const BAR_TAGS = [['drinks', 'Drink deals'], ['food', 'Food deals'], ['oysters', 'Oysters'], ['2for1', '2-for-1'], ['late', 'Late night'], ['allday', 'All day'], ['weekend', 'Weekends'], ['early', 'Starts before 4pm'], ['rooftop', 'Rooftop'], ['outdoor', 'Outdoor'], ['sports', 'Sports'], ['cocktails', 'Cocktails'], ['wine', 'Wine'], ['cheap-beer', 'Cheap beer'], ['pub', 'Pubs']];
const PARTY_TAGS = [['rooftop', 'Rooftop'], ['lgbtq', 'LGBTQ+'], ['drag', 'Drag'], ['day', 'Day party'], ['boat', 'Boat'], ['costume', 'Costumes'], ['openbar', 'Open bar']];
const WHEN = [['tonight', 'Tonight'], ['tomorrow', 'Tomorrow'], ['weekend', 'This weekend'], ['week', 'Next 7 days'], ['all', 'All dates']];
---
<section class="explorer" data-kind={kind} data-src={`/data/${kind}.json`} data-preset={JSON.stringify(preset)} data-mode={mode} aria-label={heading ?? 'Find'}>
  <div class="ex-bar">
    <div class="ex-views" role="group" aria-label="View">
      <button type="button" data-view="list" aria-pressed={String(mode === 'list')}>List</button>
      <button type="button" data-view="split" aria-pressed={String(mode === 'split')} class="split-only">List + map</button>
      <button type="button" data-view="map" aria-pressed={String(mode === 'map')}>Map</button>
    </div>
  </div>

  <div class="ex-pills" role="toolbar" aria-label="Filters">
    {/* the two questions people ask first: what is on right now, and what is near me */}
    {kind === 'bars' && show('day') && <button type="button" class="xpill quick now" data-f="day" data-v="now" aria-pressed="false"><span class="live-dot" aria-hidden="true"></span>Open now</button>}
    {kind === 'parties' && <button type="button" class="xpill quick now" data-f="when" data-v="tonight" aria-pressed="false"><span class="live-dot" aria-hidden="true"></span>Tonight</button>}
    <button type="button" class="xpill quick near" data-near>📍 Near me</button>
    {kind === 'bars' && show('day') && <button type="button" class="xpill" data-pop="when" data-keys="day,time" aria-expanded="false">When<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>}
    {kind === 'parties' && <button type="button" class="xpill" data-pop="when" data-keys="when" aria-expanded="false">When<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>}
    {show('where') && <button type="button" class="xpill" data-pop="where" data-keys="bo,hood" aria-expanded="false">Where<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>}
    {kind === 'bars' && show('line') && <button type="button" class="xpill" data-pop="line" data-keys="line" aria-expanded="false">Subway<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>}
    {kind === 'bars' && <button type="button" class="xpill" data-pop="deal" data-keys="tag,max,book" aria-expanded="false">Deal &amp; vibe<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>}
    {kind === 'parties' && genres.length > 0 && <button type="button" class="xpill" data-pop="music" data-keys="genre" aria-expanded="false">Music<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>}
    {kind === 'parties' && <button type="button" class="xpill" data-pop="vibe" data-keys="th,tag,max,age,avail" aria-expanded="false">Vibe &amp; price<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>}
    <button type="button" class="xpill" data-pop="sort" data-keys="sort" aria-expanded="false">Sort<b class="pc" hidden></b><span class="car" aria-hidden="true"></span></button>
    <button type="button" class="xclear" data-reset hidden>Clear all</button>
    <span class="ex-count" data-count aria-live="polite"></span>
  </div>

  <div class="ex-pops">
    {kind === 'bars' && show('day') && (
      <div class="pop" data-panel="when" hidden role="dialog" aria-label="When">
        <div class="chips">
          <button type="button" class="fchip hot" data-f="day" data-v="now" aria-pressed="false">Happening now</button>
          <button type="button" class="fchip" data-f="day" data-v="today" aria-pressed="false">Today</button>
          {DAYS.map(([v, l]) => <button type="button" class="fchip" data-f="day" data-v={v} aria-pressed="false">{l}</button>)}
        </div>
        <label class="sel">Happy hour on at
          <select data-f="time"><option value="">any time</option>{TIMES.map(([v, l]) => <option value={String(v)}>{l}</option>)}</select>
        </label>
        <div class="pop-foot"><button type="button" class="linkbtn" data-clear="day,time">Clear</button><button type="button" class="btn small-done" data-done>Done</button></div>
      </div>
    )}
    {kind === 'parties' && (
      <div class="pop" data-panel="when" hidden role="dialog" aria-label="When">
        <div class="chips">{WHEN.map(([v, l]) => <button type="button" class="fchip" data-f="when" data-v={v} aria-pressed="false">{l}</button>)}</div>
        <label class="sel">Date <input type="date" data-f="when" /></label>
        <div class="pop-foot"><button type="button" class="linkbtn" data-clear="when">Clear</button><button type="button" class="btn small-done" data-done>Done</button></div>
      </div>
    )}
    {show('where') && (
      <div class="pop" data-panel="where" hidden role="dialog" aria-label="Where">
        <div class="chips">{BOROUGHS.map((b) => <button type="button" class="fchip" data-f="bo" data-v={b} aria-pressed="false">{b}</button>)}</div>
        {hoods.length > 0 && (
          <label class="sel">Neighborhood
            <select data-f="hood"><option value="">all neighborhoods</option>{hoods.map((h) => <option value={kind === 'bars' ? h.slug : h.name}>{h.name}</option>)}</select>
          </label>
        )}
        <div class="pop-foot"><button type="button" class="linkbtn" data-clear="bo,hood">Clear</button><button type="button" class="btn small-done" data-done>Done</button></div>
      </div>
    )}
    {kind === 'bars' && show('line') && (
      <div class="pop" data-panel="line" hidden role="dialog" aria-label="Subway line">
        <div class="chips lines">{LINES.map((l) => <button type="button" class="fline" style={LINE_STYLE[l]} data-f="line" data-v={l} aria-pressed="false" aria-label={`${l} train`}>{l}</button>)}</div>
        <div class="pop-foot"><button type="button" class="linkbtn" data-clear="line">Clear</button><button type="button" class="btn small-done" data-done>Done</button></div>
      </div>
    )}
    {kind === 'bars' && (
      <div class="pop" data-panel="deal" hidden role="dialog" aria-label="Deal and vibe">
        <div class="chips">{BAR_TAGS.map(([v, l]) => <button type="button" class="fchip" data-f="tag" data-v={v} aria-pressed="false">{l}</button>)}</div>
        <div class="row-sel">
          <label class="sel">Cheapest drink up to
            <select data-f="max"><option value="">any price</option><option value="5">$5</option><option value="7">$7</option><option value="8">$8</option><option value="10">$10</option><option value="12">$12</option></select>
          </label>
          <label class="check"><input type="checkbox" data-f="book" /> Can book a table</label>
        </div>
        <div class="pop-foot"><button type="button" class="linkbtn" data-clear="tag,max,book">Clear</button><button type="button" class="btn small-done" data-done>Done</button></div>
      </div>
    )}
    {kind === 'parties' && genres.length > 0 && (
      <div class="pop" data-panel="music" hidden role="dialog" aria-label="Music">
        <div class="chips">{genres.map((g) => <button type="button" class="fchip" data-f="genre" data-v={g} aria-pressed="false">{GENRE_NAME[g] ?? g}</button>)}</div>
        <div class="pop-foot"><button type="button" class="linkbtn" data-clear="genre">Clear</button><button type="button" class="btn small-done" data-done>Done</button></div>
      </div>
    )}
    {kind === 'parties' && (
      <div class="pop" data-panel="vibe" hidden role="dialog" aria-label="Vibe and price">
        <div class="chips">
          <button type="button" class="fchip" data-f="th" data-v="halloween" aria-pressed="false">Halloween</button>
          <button type="button" class="fchip" data-f="th" data-v="nye" aria-pressed="false">New Year's Eve</button>
          {PARTY_TAGS.map(([v, l]) => <button type="button" class="fchip" data-f="tag" data-v={v} aria-pressed="false">{l}</button>)}
        </div>
        <div class="row-sel">
          <label class="sel">Price up to
            <select data-f="max"><option value="">any price</option><option value="0">Free</option><option value="20">$20</option><option value="40">$40</option><option value="75">$75</option></select>
          </label>
          <label class="check"><input type="checkbox" data-f="age" value="18" /> 18+ welcome</label>
          <label class="check"><input type="checkbox" data-f="avail" /> Hide sold out</label>
        </div>
        <div class="pop-foot"><button type="button" class="linkbtn" data-clear="th,tag,max,age,avail">Clear</button><button type="button" class="btn small-done" data-done>Done</button></div>
      </div>
    )}
    <div class="pop" data-panel="sort" hidden role="dialog" aria-label="Sort">
      <div class="chips">
        {kind === 'bars'
          ? <><button type="button" class="fchip" data-f="sort" data-v="" aria-pressed="false">Best match</button><button type="button" class="fchip" data-f="sort" data-v="cheap" aria-pressed="false">Cheapest drink</button><button type="button" class="fchip" data-f="sort" data-v="ending" aria-pressed="false">Ending soonest</button><button type="button" class="fchip" data-f="sort" data-v="near" aria-pressed="false">Nearest</button></>
          : <><button type="button" class="fchip" data-f="sort" data-v="" aria-pressed="false">Soonest</button><button type="button" class="fchip" data-f="sort" data-v="cheap" aria-pressed="false">Cheapest</button><button type="button" class="fchip" data-f="sort" data-v="near" aria-pressed="false">Nearest</button></>}
      </div>
    </div>
  </div>

  <div class="ex-body">
    <div class="ex-list">
      <div class="xgrid" data-list><slot /></div>
      <button type="button" class="btn ghost more" data-more hidden>Show more</button>
    </div>
    <div class="ex-map" data-map role="region" aria-label="Map"><MapPoster show={kind === 'bars' ? 'bars' : 'parties'} /></div>
  </div>
</section>

<script>
  import { initExplorer } from '../scripts/explorer';
  document.querySelectorAll<HTMLElement>('.explorer').forEach((el) => initExplorer(el));
</script>

<style is:global>
  .explorer { margin: 20px 0 8px; }
  .ex-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .ex-views { display: inline-flex; padding: 3px; gap: 2px; border-radius: 999px; background: #F1EEF8; }
  .ex-views button { border: 0; background: transparent; border-radius: 999px; font: inherit; font-size: 14px; font-weight: 700; padding: 0 14px; min-height: 40px; cursor: pointer; color: var(--ink-2); }
  .ex-views button[aria-pressed='true'] { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(22,18,43,.14); }
  @media (max-width: 899px) { .split-only { display: none; } }
  /* filters: a row of pills; each opens a small panel (a bottom sheet on phones) */
  .ex-pills { display: flex; align-items: center; gap: 8px; margin-top: 12px; overflow-x: auto; scrollbar-width: none; padding-bottom: 2px; }
  .ex-pills::-webkit-scrollbar { display: none; }
  .xpill { flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; font-size: 14px; font-weight: 700; color: var(--ink); cursor: pointer; }
  .xpill:hover { border-color: var(--brand); }
  .xpill.on { background: var(--brand-soft, #EFEAFD); border-color: var(--brand); color: var(--brand); }
  .xpill[aria-expanded='true'] { border-color: var(--brand); }
  /* the quick ones lead the row: bigger, outlined in ink, green when on */
  .xpill.quick { min-height: 42px; font-size: 15px; font-weight: 800; border: 1.5px solid var(--ink); }
  .xpill.now[aria-pressed='true'] { background: var(--green); border-color: var(--green); color: #fff; }
  .xpill.near.on { background: var(--brand); border-color: var(--brand); color: #fff; }
  .live-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px rgba(11, 122, 75, .18); }
  .xpill.now[aria-pressed='true'] .live-dot { background: #fff; box-shadow: none; }
  .xpill .pc.word { background: transparent; color: inherit; padding: 0; font-weight: 600; min-width: 0; }
  .xpill .pc { background: var(--brand); color: #fff; border-radius: 999px; font-size: 12px; min-width: 20px; height: 20px; padding: 0 6px; display: inline-grid; place-items: center; }
  .xpill .car { width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg) translateY(-2px); opacity: .6; }
  .xclear { flex: none; background: none; border: 0; font: inherit; font-size: 15px; font-weight: 700; color: var(--brand); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; min-height: 40px; padding: 0 4px; }
  .ex-count { flex: none; margin-left: auto; font-weight: 700; color: var(--ink-2); font-size: 15px; padding-left: 8px; white-space: nowrap; }
  .ex-pops { position: relative; }
  .pop { position: absolute; z-index: 30; top: 8px; left: 0; width: min(520px, 100%); background: #fff; border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 18px 50px rgba(22,18,43,.18); padding: 16px; display: grid; gap: 12px; }
  .pop-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; border-top: 1px solid var(--line); padding-top: 12px; }
  .small-done { min-height: 40px; padding: 0 18px; }
  @media (max-width: 719px) {
    .pop { position: fixed; z-index: 60; left: 0 !important; right: 0; bottom: 0; top: auto; width: 100%; max-height: 75vh; overflow-y: auto; border-radius: 20px 20px 0 0; padding: 18px max(16px, env(safe-area-inset-left, 0px)) calc(18px + env(safe-area-inset-bottom, 0px)); }
    .ex-scrim { position: fixed; inset: 0; background: rgba(22,18,43,.35); z-index: 59; }
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .fchip { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 0 14px; min-height: 38px; font: inherit; font-size: 14px; font-weight: 700; color: var(--ink-2); cursor: pointer; }
  .fchip:hover { border-color: var(--brand); }
  .fchip[aria-pressed='true'] { background: var(--brand); border-color: var(--brand); color: #fff; }
  .fchip.hot[aria-pressed='true'] { background: var(--green); color: #fff; border-color: var(--green); }
  .lines { gap: 6px; }
  .fline { width: 40px; height: 40px; border-radius: 50%; border: 3px solid transparent; font: inherit; font-weight: 800; cursor: pointer; }
  .fline[aria-pressed='true'] { border-color: #fff; box-shadow: 0 0 0 3px var(--brand); }
  .sel { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; flex-wrap: wrap; }
  .sel select, .sel input { min-height: 40px; border: 1.5px solid var(--line); border-radius: 10px; padding: 0 10px; font: inherit; background: #fff; }
  .row-sel { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; }
  .check { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 15px; min-height: 40px; }
  .check input { width: 20px; height: 20px; accent-color: var(--brand); }
  .linkbtn { background: none; border: 0; padding: 0; font: inherit; font-weight: 700; text-decoration: underline; text-decoration-color: var(--brand); text-underline-offset: 3px; cursor: pointer; min-height: 40px; }
  .ex-body { display: grid; gap: 18px; margin-top: 18px; }
  .ex-map { position: relative; min-height: 420px; border-radius: var(--radius); overflow: hidden; border: 1.5px solid var(--line); background: #ECE8F6; }
  .explorer[data-mode='list'] .ex-map { display: none; }
  .explorer[data-mode='map'] .ex-list { display: none; }
  .explorer[data-mode='map'] .ex-map { min-height: 72vh; }
  @media (min-width: 900px) {
    .explorer[data-mode='split'] .ex-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
    .explorer[data-mode='split'] .ex-map { position: sticky; top: 84px; height: calc(100vh - 110px); min-height: 480px; }
  }
  @media (max-width: 899px) { .explorer[data-mode='split'] .ex-map { display: none; } }
  .maplibregl-popup-content { border-radius: 12px; font-family: var(--font); padding: 12px 14px; }
</style>
