---
/**
 * Every page: unique title + description, canonical, Open Graph, JSON-LD, the
 * header and the footer. Analytics load after the page (PUBLIC_GA_ID at build time;
 * none set = no analytics at all).
 */
import Logo from '../components/Logo.astro';
import { GA_MEASUREMENT_ID, GOOGLE_SITE_VERIFICATION, BING_SITE_VERIFICATION } from '../lib/site';
import { allGuides } from '../lib/guides';
import Newsletter from '../components/Newsletter.astro';
import { listPages } from '../lib/lists';
// the font is self-hosted (no render-blocking request to Google Fonts)
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** the one search phrase this page is built to rank for; the build gate checks it is in
   *  the title, the h1 and the description, and that no other page targets it */
  keyword?: string;
  jsonld?: object[];
  noindex?: boolean;
  ogImage?: string | null;
  wide?: boolean;
}
const { title, description, keyword, jsonld = [], noindex = false, ogImage = null, wide = false } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const fullTitle = title.length > 60 || / \| YaY NYC$/.test(title) || path === '/' ? title : `${title} | YaY NYC`;
const GA = (import.meta.env.PUBLIC_GA_ID as string | undefined) || GA_MEASUREMENT_ID;
const hasGuides = (await allGuides()).some((g) => g.status === 'published');
const nav = [
  { href: '/happy-hours', label: 'Happy Hours' },
  { href: '/parties', label: 'Parties' },
  { href: '/map', label: 'Map' },
  { href: '/happy-hours/neighborhoods', label: 'Neighborhoods' },
  // the guides link appears once a guide is published
  ...(hasGuides ? [{ href: '/blog', label: 'Guides' }] : []),
];
// the one call to action in the header: the season's big night, otherwise what is on right now
const seasonal = new Date().toISOString().slice(0, 10) <= '2026-11-01' ? { href: '/parties/halloween', label: 'Halloween' } : { href: '/happy-hours/now', label: 'On now' };
const on = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const ICON: Record<string, string> = {
  glass: '<path d="M6 3h12l-1.5 8a4.5 4.5 0 0 1-9 0L6 3zm6 13v5m-4 0h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  party: '<path d="M4 20l5-14 9 9-14 5zM14 4l1 2m4 3l2-1m-6-5l-1 3m5 6l3 1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  map: '<path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2zm0 0v14m6-12v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
  book: '<path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2V5zm0 16a2 2 0 0 1 2-2h12v2" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="10" r="2.5" fill="currentColor"/>',
};
// the full menu (a drawer, every screen size): only links to pages this build has
const lists = new Set((await listPages()).map((l) => l.slug));
const hh = (slug: string, label: string) => (lists.has(slug) ? [{ href: `/happy-hours/${slug}`, label }] : []);
const guidesMenu = (await allGuides()).filter((g) => g.status === 'published').sort((a, b) => b.updated.localeCompare(a.updated)).slice(0, 4);
const menu = [
  { h: 'Happy hours', links: [{ href: '/happy-hours/now', label: 'On right now' }, { href: '/happy-hours', label: 'All happy hours' },
    ...hh('cheap-drinks', 'Drinks $6 and under'), ...hh('rooftop', 'Rooftops'), ...hh('food', 'Food deals'), ...hh('oysters', 'Oysters'),
    ...hh('late-night', 'Late night'), { href: '/happy-hours/neighborhoods', label: 'By neighborhood' }] },
  { h: 'Parties', links: [{ href: '/parties?when=tonight', label: 'Tonight' }, { href: '/parties?when=weekend', label: 'This weekend' },
    ...(seasonal.href === '/parties/halloween' ? [{ href: '/parties/halloween', label: 'Halloween' }] : []), { href: '/parties', label: 'All parties' }] },
  { h: 'Trivia and games', links: [{ href: '/trivia', label: 'Trivia nights' }, { href: '/music-bingo', label: 'Music bingo' }, { href: '/bars-with-games', label: 'Bars with games' }] },
  { h: 'Maps', links: [{ href: '/map/happy-hours', label: 'Happy hour map' }, { href: '/map/parties', label: 'Party map' }] },
  ...(guidesMenu.length ? [{ h: 'Guides', links: [...guidesMenu.map((g) => ({ href: `/blog/${g.slug}`, label: g.short })), { href: '/blog', label: 'All guides' }] }] : []),
  { h: 'YaY NYC', links: [{ href: '/about', label: 'How we check' }, { href: '/contact', label: 'Share a tip' }] },
];
const tabs = [
  { href: '/happy-hours', label: 'Happy hours', icon: 'glass' },
  { href: '/parties', label: 'Parties', icon: 'party' },
  { href: '/map', label: 'Map', icon: 'map' },
  hasGuides ? { href: '/blog', label: 'Guides', icon: 'book' } : { href: '/happy-hours/neighborhoods', label: 'Areas', icon: 'pin' },
];
---
<!doctype html>
<html lang="en" data-kw={noindex ? undefined : keyword}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {path === '/' && GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
  {path === '/' && BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  <slot name="head" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="apple-mobile-web-app-title" content="YaY NYC" />
  <meta name="theme-color" content="#16122B" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="YaY NYC" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={new URL(ogImage ?? '/og-default.png', Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  {GA && (
    <script is:inline define:vars={{ GA }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA, { content_group: location.pathname.split('/')[1] || 'home' });
      addEventListener('load', function () { setTimeout(function () {
        var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA; document.head.appendChild(s);
      }, 0); });
      // outbound clicks by kind: tickets, bookings, directions, calls
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]'); if (!a) return;
        var h = a.getAttribute('href') || '', u; try { u = new URL(h, location.href); } catch (_) { return; }
        var kind = /^tel:/.test(h) ? 'call_click' : u.host === location.host ? null
          : /dice\.fm|eventbrite|ra\.co|shotgun|joonbug|posh\.vip|fever/.test(u.host) ? 'ticket_click'
          : /resy|opentable|sevenrooms|tock/.test(u.host) ? 'booking_click'
          : /google\.[a-z.]+\/maps|maps\.google\.|maps\.apple|maps\.app\.goo\.gl/.test(u.href) ? 'directions_click' : 'outbound_click';
        if (kind) gtag('event', kind, { link_domain: u.host, page: location.pathname });
      }, true);
    </script>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <a href="/" class="logo-link"><Logo size={34} /></a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={on(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          <li><a class="nav-cta" href={seasonal.href}>{seasonal.label}</a></li>
        </ul>
      </nav>
      <div class="header-end">
        <a class="header-cta" href={seasonal.href}>{seasonal.label}</a>
        <button class="menu-btn" type="button" aria-haspopup="dialog" aria-controls="menu" aria-label="Menu" data-menu-open>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
          <span>Menu</span>
        </button>
      </div>
    </div>
  </header>
  <dialog id="menu" class="menu" aria-label="Menu">
    <div class="menu-head">
      <a href="/" class="logo-link"><Logo size={28} /></a>
      <button class="menu-x" type="button" data-menu-close aria-label="Close menu">✕</button>
    </div>
    <form action="/happy-hours" method="get" class="menu-search" role="search">
      <label for="mq" class="sr">Search happy hours</label>
      <input id="mq" name="q" type="search" placeholder="Bar, neighborhood or subway stop" />
    </form>
    <div class="menu-grid">
      {menu.map((g) => (
        <section>
          <h2>{g.h}</h2>
          <ul>{g.links.map((l) => <li><a href={l.href} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a></li>)}</ul>
        </section>
      ))}
    </div>
    <a class="btn coral menu-nl" href="#newsletter">Get the Thursday email</a>
  </dialog>
  <script>
    // static pages, live time: a party whose night is over is hidden from lists, and
    // [data-show-after] notes (for example "this party has ended") appear once their time has passed
    const hideEnded = () => {
      const now = Date.now();
      document.querySelectorAll<HTMLElement>('.xcard[data-end]').forEach((el) => { if (Date.parse(el.dataset.end!) < now) el.hidden = true; });
      document.querySelectorAll<HTMLElement>('[data-show-after]').forEach((el) => { if (Date.parse(el.dataset.showAfter!) < now) el.hidden = false; });
    };
    hideEnded();
    new MutationObserver(hideEnded).observe(document.body, { childList: true, subtree: true });
  </script>
  <script>
    const m = document.getElementById('menu') as HTMLDialogElement;
    document.querySelector('[data-menu-open]')?.addEventListener('click', () => { m.showModal(); (window as any).gtag?.('event', 'menu_open'); });
    m.querySelector('[data-menu-close]')?.addEventListener('click', () => m.close());
    m.addEventListener('click', (e) => { if (e.target === m || (e.target as HTMLElement).closest('a')) m.close(); });
  </script>
  <nav class="tabbar" aria-label="Sections">
    {tabs.map((t) => <a href={t.href} aria-current={on(t.href) ? 'page' : undefined}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON[t.icon]} />{t.label}</a>)}
  </nav>
  <main id="main" class:list={[wide ? 'wide' : 'wrap']}>
    <slot />
  </main>
  {path !== '/' && <div class="wrap foot-nl"><Newsletter source="footer" compact /></div>}
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <Logo size={28} light />
        <p class="tagline">All the fun in one place!</p>
        <p class="small">A free community guide: no one can pay to be listed or ranked. Every happy hour shows the date we last checked it and a link to where we read it. Deals change: confirm with the bar before you go. Drink responsibly; you must be 21 to drink in New York.</p>
      </div>
      <div>
        <h2 class="foot-h">Find</h2>
        <ul class="foot-list">
          <li><a href="/happy-hours">NYC happy hours</a></li>
          <li><a href="/happy-hours/now">Happy hour right now</a></li>
          <li><a href="/parties">Parties in NYC</a></li>
          <li><a href="/trivia">Trivia nights</a></li>
          <li><a href="/bars-with-games">Bars with games</a></li>
          <li><a href="/map">Map</a></li>
          {hasGuides && <li><a href="/blog">Guides</a></li>}
        </ul>
      </div>
      <div>
        <h2 class="foot-h">YaY NYC</h2>
        <ul class="foot-list">
          <li><a href="/about">About and how we check</a></li>
          <li><a href="/contact">Share a tip or fix a listing</a></li>
          <li><a href="/image-credits">Image credits and takedown</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/accessibility">Accessibility</a></li>
        </ul>
      </div>
    </div>
    <p class="wrap small copyright">© {new Date().getFullYear()} YaY NYC · Map data © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors</p>
  </footer>
</body>
</html>
<style is:global>
  .nav-cta { background: var(--coral-btn); color: #fff !important; }
  .nav-cta:hover { background: var(--coral-ink) !important; }
  .foot-nl { margin-top: 48px; }
</style>
