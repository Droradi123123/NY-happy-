// Cloudflare Workers, static assets only: the whole site is the dist/ folder.
// Deployed by .github/workflows/deploy-site.yml (`npx wrangler deploy` from site/).
// The custom domain needs the yaynyc.com zone in the same Cloudflare account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaynyc",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "yaynyc.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
